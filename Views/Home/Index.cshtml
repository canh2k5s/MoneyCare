<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tổng quan - MoneyCare</title>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="css/site.css" rel="stylesheet">
</head>
<body>
<div class="app">
  <aside class="sidebar">

    <a class="brand"
       asp-controller="Home"
       asp-action="Index">
        <i class="bi bi-wallet2"></i> MoneyCare
    </a>

    <a class="item" asp-controller="Home" asp-action="Index">
        <i class="bi bi-grid-1x2-fill"></i> Tổng quan
    </a>

    <a class="item" asp-controller="Home" asp-action="GiaoDich">
        <i class="bi bi-arrow-left-right"></i> Thu chi
    </a>

    <a class="item" asp-controller="Home" asp-action="NganSach">
        <i class="bi bi-pie-chart-fill"></i> Ngân sách
    </a>

    <a class="item" asp-controller="Home" asp-action="TietKiem">
        <i class="bi bi-piggy-bank-fill"></i> Tiết kiệm
    </a>

</aside>
  <main class="content">
    <h1 class="page-title">Tổng quan tài chính</h1>
    <p class="page-sub">Tháng 10/2026</p>

    <div class="hero mb-4">
      <div class="row g-4 align-items-center">
        <div class="col-lg-5">
          <div class="opacity-75">Số dư khả dụng</div>
          <div class="big">4.900.000đ</div>
          <div class="opacity-75 mt-1">Lương 8.000.000đ − chi 2.100.000đ − tiết kiệm 1.000.000đ</div>
        </div>
        <div class="col-lg-7">
          <div class="row g-3">
            <div class="col-4"><div class="chip"><small><i class="bi bi-arrow-down-circle"></i> Tổng thu</small><b>8.000.000đ</b></div></div>
            <div class="col-4"><div class="chip"><small><i class="bi bi-arrow-up-circle"></i> Tổng chi</small><b>2.100.000đ</b></div></div>
            <div class="col-4"><div class="chip"><small><i class="bi bi-piggy-bank"></i> Đã tiết kiệm</small><b>1.000.000đ</b></div></div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4 mb-4">
      <div class="col-lg-5">
        <div class="box">
          <h2>Tiền lương đã đi đâu?</h2>
          <div class="donut"><div><small class="text-secondary">Đã dùng</small><b class="fs-4">38,75%</b></div></div>
          <ul class="list-unstyled mt-4 mb-0">
            <li class="d-flex justify-content-between mb-2"><span><span class="dot" style="background:var(--spent)"></span>Đã chi</span><b>2.100.000đ</b></li>
            <li class="d-flex justify-content-between mb-2"><span><span class="dot" style="background:var(--save)"></span>Đã tiết kiệm</span><b>1.000.000đ</b></li>
            <li class="d-flex justify-content-between"><span><span class="dot" style="background:var(--income)"></span>Còn dùng được</span><b>4.900.000đ</b></li>
          </ul>
        </div>
      </div>
      <div class="col-lg-7">
        <div class="box">
          <h2>Ngân sách đã phân bổ</h2>
          <div class="d-flex align-items-center gap-3 mb-3"><span class="ico ico-food"><i class="bi bi-cup-hot-fill"></i></span>
            <div class="flex-grow-1"><div class="d-flex justify-content-between"><b>Ăn uống</b><small class="text-secondary">800.000đ / 2.000.000đ</small></div>
            <div class="progress mt-1"><div class="progress-bar bar-ok" style="width:40%"></div></div></div><b class="ms-2">40%</b></div>
          <div class="d-flex align-items-center gap-3 mb-3"><span class="ico ico-home"><i class="bi bi-house-door-fill"></i></span>
            <div class="flex-grow-1"><div class="d-flex justify-content-between"><b>Phòng trọ</b><small class="text-secondary">1.000.000đ / 1.800.000đ</small></div>
            <div class="progress mt-1"><div class="progress-bar bar-ok" style="width:56%"></div></div></div><b class="ms-2">56%</b></div>
          <div class="d-flex align-items-center gap-3 mb-3"><span class="ico ico-bill"><i class="bi bi-lightning-charge-fill"></i></span>
            <div class="flex-grow-1"><div class="d-flex justify-content-between"><b>Điện, nước, mạng</b><small class="text-secondary">200.000đ / 500.000đ</small></div>
            <div class="progress mt-1"><div class="progress-bar bar-ok" style="width:40%"></div></div></div><b class="ms-2">40%</b></div>
          <div class="d-flex align-items-center gap-3"><span class="ico ico-move"><i class="bi bi-bus-front-fill"></i></span>
            <div class="flex-grow-1"><div class="d-flex justify-content-between"><b>Đi lại</b><small class="text-secondary">100.000đ / 500.000đ</small></div>
            <div class="progress mt-1"><div class="progress-bar bar-ok" style="width:20%"></div></div></div><b class="ms-2">20%</b></div>
        </div>
      </div>
    </div>

    <div class="box">
      <h2>Mục tiêu tiết kiệm</h2>
      <div class="row g-4">
        <div class="col-md-6"><div class="d-flex align-items-center gap-3"><span class="ico ico-save"><i class="bi bi-phone-fill"></i></span>
          <div class="flex-grow-1"><div class="d-flex justify-content-between"><b>Mua điện thoại</b><small class="text-secondary">1.000.000đ / 10.000.000đ</small></div>
          <div class="progress mt-1"><div class="progress-bar bar-save" style="width:10%"></div></div></div><b>10%</b></div></div>
        <div class="col-md-6"><div class="d-flex align-items-center gap-3"><span class="ico ico-save"><i class="bi bi-shield-check"></i></span>
          <div class="flex-grow-1"><div class="d-flex justify-content-between"><b>Quỹ khẩn cấp</b><small class="text-secondary">0đ / 5.000.000đ</small></div>
          <div class="progress mt-1"><div class="progress-bar bar-save" style="width:0%"></div></div></div><b>0%</b></div></div>
      </div>
    </div>
  </main>
</div>
</body>
</html>