@{
    Layout = null;
    ViewData["Title"] = "Tổng quan";
}

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tổng quan - MoneyCare</title>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link href="css/site.css" rel="stylesheet">
  
  <style>
      /* Cấu trúc tổng thể để chứa Header/Footer */
      body { margin: 0; font-family: "Segoe UI", Arial, sans-serif; background: #f4f7fc; color: #172554; display: flex; flex-direction: column; min-height: 100vh; }
      .app { display: flex; flex: 1; }

      /* --- HEADER --- */
      .top-header { display: flex; justify-content: space-between; align-items: center; height: 70px; padding: 0 32px; background: white; border-bottom: 1px solid #e2e8f0; flex-shrink: 0; }
      .brand-top { font-size: 24px; font-weight: 750; color: #2563eb; text-decoration: none; display: flex; align-items: center; gap: 10px; }
      .user-menu { display: flex; align-items: center; gap: 15px; }
      .user-name { color: #334155; font-weight: 600; font-size: 15px; }
      .user-name i { color: #2563eb; margin-right: 5px; font-size: 18px; }
      
      .btn-logout { border: 1px solid #2563eb; color: #2563eb; background: transparent; padding: 8px 16px; border-radius: 8px; font-weight: 650; font-size: 14px; text-decoration: none; transition: 0.2s; display: flex; align-items: center; gap: 8px; }
      .btn-logout:hover { background: #2563eb; color: white; }
      
      .btn-register { border: 1px solid #2563eb; background: #2563eb; color: white; padding: 8px 16px; border-radius: 8px; font-weight: 650; font-size: 14px; text-decoration: none; transition: 0.2s; display: flex; align-items: center; gap: 8px; }
      .btn-register:hover { background: #1d4ed8; border-color: #1d4ed8; color: white; }

      /* --- SIDEBAR --- */
      .sidebar { width: 250px !important; flex-shrink: 0; padding: 25px 16px !important; background: linear-gradient(180deg, #172f59, #1e40af) !important; color: white !important; min-height: 100%; }
      .brand { display: flex !important; align-items: center; gap: 12px; margin: 0 0 38px !important; padding: 0 8px !important; color: white !important; text-decoration: none !important; font-size: 22px !important; font-weight: 750 !important; }
      .brand-icon { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 12px; background: #10b981; font-size: 20px; }
      .nav a { display: flex !important; align-items: center; gap: 14px; padding: 13px 14px !important; margin-bottom: 7px !important; border-radius: 10px !important; color: #dbeafe !important; text-decoration: none !important; font-size: 15px !important; transition: .2s; }
      .nav a i { width: 21px; text-align: center; font-size: 17px; }
      .nav a:hover, .nav a.active { background: #3565c5 !important; color: white !important; }
      .nav a.active { box-shadow: inset 4px 0 #fbbf24 !important; }

      /* --- FOOTER --- */
      .app-footer { background: white; padding: 24px 36px; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; flex-shrink: 0; }
      .footer-left { display: flex; flex-direction: column; gap: 8px; }
      .footer-brand { font-size: 22px; font-weight: 750; color: #2563eb; text-decoration: none; display: flex; align-items: center; gap: 10px; }
      .footer-desc { margin: 0; color: #64748b; font-size: 14px; }
      .footer-right { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
      .footer-links { display: flex; gap: 12px; font-size: 14px; color: #cbd5e1; }
      .footer-links a { color: #64748b; text-decoration: none; transition: 0.2s; }
      .footer-links a:hover { color: #2563eb; }
      .footer-copy { color: #94a3b8; font-size: 13px; }

      /* Responsive */
      @@media (max-width: 650px) {
          .sidebar { width: 75px !important; padding: 20px 9px !important; }
          .brand { justify-content: center; padding: 0 !important; }
          .brand-text, .nav a span { display: none; }
          .nav a { justify-content: center; padding: 13px 5px !important; }
          .main { padding: 18px 12px; }
          .app-footer { flex-direction: column; align-items: flex-start; padding: 20px 15px; }
          .footer-right { align-items: flex-start; }
          .top-header { padding: 0 15px; }
          .user-name { display: none; }
      }
  </style>
</head>
<body>
  <!-- HEADER -->
  <header class="top-header">
      <a class="brand-top" asp-controller="Home" asp-action="Index">
          <i class="fa-solid fa-wallet"></i> MoneyCare
      </a>
      
      <div class="user-menu">
          @if (Context.Session.GetInt32("UserId") != null)
          {
              <span class="user-name"><i class="fa-solid fa-circle-user"></i> Xin chào, @(Context.Session.GetString("HoTen") ?? "Người dùng")</span>
              <a href="/Account/Logout" class="btn-logout"><i class="fa-solid fa-arrow-right-from-bracket"></i> Đăng xuất</a>
          }
          else
          {
              <a href="/Account/Login" class="btn-logout">Đăng nhập</a>
              <a href="/Account/Register" class="btn-register"><i class="fa-solid fa-user-plus"></i> Đăng ký</a>
          }
      </div>
  </header>

  <div class="app">
    <!-- SIDEBAR -->
    <aside class="sidebar">
      <a class="brand" asp-controller="Home" asp-action="Index">
          <span class="brand-icon"><i class="fa-solid fa-wallet"></i></span>
          <span class="brand-text">MoneyCare</span>
      </a>
      <nav class="nav">
          <a asp-controller="Home" asp-action="Index" class="active"><i class="fa-solid fa-table-columns"></i> <span>Tổng quan</span></a>
          <a asp-controller="Home" asp-action="GiaoDich"><i class="fa-solid fa-arrow-right-arrow-left"></i> <span>Thu chi</span></a>
          <a asp-controller="Home" asp-action="NganSach"><i class="fa-solid fa-chart-pie"></i> <span>Ngân sách</span></a>
          <a asp-controller="Home" asp-action="TietKiem"><i class="fa-solid fa-piggy-bank"></i> <span>Tiết kiệm</span></a>
          <a asp-controller="DanhMuc" asp-action="Index"><i class="fa-solid fa-folder-open"></i> <span>Danh mục</span></a>
      </nav>
    </aside>

    <!-- NỘI DUNG CHÍNH -->
    <main class="content" style="padding: 32px 36px; flex: 1;">
      <h1 class="page-title" style="font-size: 27px; font-weight: 750; margin-bottom: 5px;">Tổng quan tài chính</h1>
      <p class="page-sub" style="color: #64748b; margin-bottom: 25px;">Tháng 10/2026</p>

      <div class="hero mb-4">
        <div class="row g-4 align-items-center">
          <div class="col-lg-5">
            <div class="opacity-75">Số dư khả dụng</div>
            <div class="big">4.900.000đ</div>
            <div class="opacity-75 mt-1">Lương 8.000.000đ − chi 2.100.000đ − tiết kiệm 1.000.000đ</div>
          </div>
          <div class="col-lg-7">
            <div class="row g-3">
              <div class="col-4"><div class="chip"><small><i class="bi bi-arrow-down-circle"></i> Tổng thu</small><b>8.000.000đ</b></div></div>
              <div class="col-4"><div class="chip"><small><i class="bi bi-arrow-up-circle"></i> Tổng chi</small><b>2.100.000đ</b></div></div>
              <div class="col-4"><div class="chip"><small><i class="bi bi-piggy-bank"></i> Đã tiết kiệm</small><b>1.000.000đ</b></div></div>
            </div>
          </div>
        </div>
      </div>

      <div class="row g-4 mb-4">
        <div class="col-lg-5">
          <div class="box">
            <h2>Tiền lương đã đi đâu?</h2>
            <div class="donut"><div><small class="text-secondary">Đã dùng</small><b class="fs-4">38,75%</b></div></div>
            <ul class="list-unstyled mt-4 mb-0">
              <li class="d-flex justify-content-between mb-2"><span><span class="dot" style="background:var(--spent)"></span>Đã chi</span><b>2.100.000đ</b></li>
              <li class="d-flex justify-content-between mb-2"><span><span class="dot" style="background:var(--save)"></span>Đã tiết kiệm</span><b>1.000.000đ</b></li>
              <li class="d-flex justify-content-between"><span><span class="dot" style="background:var(--income)"></span>Còn dùng được</span><b>4.900.000đ</b></li>
            </ul>
          </div>
        </div>
        <div class="col-lg-7">
          <div class="box">
            <h2>Ngân sách đã phân bổ</h2>
            <div class="d-flex align-items-center gap-3 mb-3"><span class="ico ico-food"><i class="bi bi-cup-hot-fill"></i></span>
              <div class="flex-grow-1"><div class="d-flex justify-content-between"><b>Ăn uống</b><small class="text-secondary">800.000đ / 2.000.000đ</small></div>
              <div class="progress mt-1"><div class="progress-bar bar-ok" style="width:40%"></div></div></div><b class="ms-2">40%</b></div>
            <div class="d-flex align-items-center gap-3 mb-3"><span class="ico ico-home"><i class="bi bi-house-door-fill"></i></span>
              <div class="flex-grow-1"><div class="d-flex justify-content-between"><b>Phòng trọ</b><small class="text-secondary">1.000.000đ / 1.800.000đ</small></div>
              <div class="progress mt-1"><div class="progress-bar bar-ok" style="width:56%"></div></div></div><b class="ms-2">56%</b></div>
            <div class="d-flex align-items-center gap-3 mb-3"><span class="ico ico-bill"><i class="bi bi-lightning-charge-fill"></i></span>
              <div class="flex-grow-1"><div class="d-flex justify-content-between"><b>Điện, nước, mạng</b><small class="text-secondary">200.000đ / 500.000đ</small></div>
              <div class="progress mt-1"><div class="progress-bar bar-ok" style="width:40%"></div></div></div><b class="ms-2">40%</b></div>
            <div class="d-flex align-items-center gap-3"><span class="ico ico-move"><i class="bi bi-bus-front-fill"></i></span>
              <div class="flex-grow-1"><div class="d-flex justify-content-between"><b>Đi lại</b><small class="text-secondary">100.000đ / 500.000đ</small></div>
              <div class="progress mt-1"><div class="progress-bar bar-ok" style="width:20%"></div></div></div><b class="ms-2">20%</b></div>
          </div>
        </div>
      </div>

      <div class="box">
        <h2>Mục tiêu tiết kiệm</h2>
        <div class="row g-4">
          <div class="col-md-6"><div class="d-flex align-items-center gap-3"><span class="ico ico-save"><i class="bi bi-phone-fill"></i></span>
            <div class="flex-grow-1"><div class="d-flex justify-content-between"><b>Mua điện thoại</b><small class="text-secondary">1.000.000đ / 10.000.000đ</small></div>
            <div class="progress mt-1"><div class="progress-bar bar-save" style="width:10%"></div></div></div><b>10%</b></div></div>
          <div class="col-md-6"><div class="d-flex align-items-center gap-3"><span class="ico ico-save"><i class="bi bi-shield-check"></i></span>
            <div class="flex-grow-1"><div class="d-flex justify-content-between"><b>Quỹ khẩn cấp</b><small class="text-secondary">0đ / 5.000.000đ</small></div>
            <div class="progress mt-1"><div class="progress-bar bar-save" style="width:0%"></div></div></div><b>0%</b></div></div>
        </div>
      </div>
    </main>
  </div>

  <!-- FOOTER -->
  <footer class="app-footer">
      <div class="footer-left">
          <a class="footer-brand" asp-controller="Home" asp-action="Index">
              <i class="fa-solid fa-wallet"></i> MoneyCare
          </a>
          <p class="footer-desc">Quản lý thu chi thông minh, xây dựng tương lai tài chính tốt hơn.</p>
      </div>
      <div class="footer-right">
          <div class="footer-links">
              <a href="#">Trang chủ</a> |
              <a href="#">Giới thiệu</a> |
              <a href="#">Liên hệ</a>
          </div>
          <div class="footer-copy">
              &copy; 2026 MoneyCare. All rights reserved.
          </div>
      </div>
  </footer>
</body>
</html>