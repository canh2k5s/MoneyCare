@{
    Layout = null;
    ViewData["Title"] = "Tiết kiệm";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tiết kiệm - MoneyCare</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: "Segoe UI", Arial, sans-serif; background: #f4f7fc; color: #172554; display: flex; flex-direction: column; min-height: 100vh; }
        .app { display: flex; flex: 1; }
        
        /* --- HEADER --- */
        .top-header { display: flex; justify-content: space-between; align-items: center; height: 70px; padding: 0 32px; background: white; border-bottom: 1px solid #e2e8f0; flex-shrink: 0; }
        .brand-top { font-size: 24px; font-weight: 750; color: #2563eb; text-decoration: none; display: flex; align-items: center; gap: 10px; }
        .user-menu { display: flex; align-items: center; gap: 15px; }
        .user-name { color: #334155; font-weight: 600; font-size: 15px; }
        .user-name i { color: #2563eb; margin-right: 5px; font-size: 18px; }
        
        .btn-logout { border: 1px solid #2563eb; color: #2563eb; background: transparent; padding: 8px 16px; border-radius: 8px; font-weight: 650; font-size: 14px; text-decoration: none; transition: 0.2s; display: flex; align-items: center; gap: 8px; }
        .btn-logout:hover { background: #2563eb; color: white; }
        
        .btn-register { border: 1px solid #2563eb; background: #2563eb; color: white; padding: 8px 16px; border-radius: 8px; font-weight: 650; font-size: 14px; text-decoration: none; transition: 0.2s; display: flex; align-items: center; gap: 8px; }
        .btn-register:hover { background: #1d4ed8; border-color: #1d4ed8; color: white; }

        /* --- FOOTER --- */
        .app-footer { background: white; padding: 24px 36px; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; flex-shrink: 0; }
        .footer-left { display: flex; flex-direction: column; gap: 8px; }
        .footer-brand { font-size: 22px; font-weight: 750; color: #2563eb; text-decoration: none; display: flex; align-items: center; gap: 10px; }
        .footer-desc { margin: 0; color: #64748b; font-size: 14px; }
        .footer-right { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
        .footer-links { display: flex; gap: 12px; font-size: 14px; color: #cbd5e1; }
        .footer-links a { color: #64748b; text-decoration: none; transition: 0.2s; }
        .footer-links a:hover { color: #2563eb; }
        .footer-copy { color: #94a3b8; font-size: 13px; }

        /* Sidebar */
        .sidebar { width: 250px; flex-shrink: 0; padding: 25px 16px; background: linear-gradient(180deg, #172f59, #1e40af); color: white; }
        .brand { display: flex; align-items: center; gap: 12px; margin: 0 0 38px; padding: 0 8px; color: white; text-decoration: none; font-size: 22px; font-weight: 750; }
        .brand-icon { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 12px; background: #10b981; font-size: 20px; }
        .nav a { display: flex; align-items: center; gap: 14px; padding: 13px 14px; margin-bottom: 7px; border-radius: 10px; color: #dbeafe; text-decoration: none; font-size: 15px; transition: .2s; }
        .nav a i { width: 21px; text-align: center; font-size: 17px; }
        .nav a:hover, .nav a.active { background: #3565c5; color: white; }
        .nav a.active { box-shadow: inset 4px 0 #fbbf24; }

        /* Main content */
        .main { flex: 1; min-width: 0; padding: 32px 36px; }
        .page-header { display: flex; justify-content: space-between; align-items: center; gap: 15px; margin-bottom: 25px; }
        .page-title { display: flex; align-items: center; gap: 15px; }
        .page-title-icon { width: 54px; height: 54px; display: grid; place-items: center; border-radius: 14px; background: #dbeafe; color: #2563eb; font-size: 27px; }
        .page-title h1 { margin: 0; font-size: 27px; font-weight: 750; color: #172554; }
        .page-title p { margin: 5px 0 0; color: #64748b; font-size: 14px; }

        /* Form Box & Cards */
        .box { background: white; border: 1px solid #e2e8f0; border-radius: 15px; padding: 25px; box-shadow: 0 3px 12px rgba(15, 23, 42, .04); }
        .form-label { font-weight: 600; color: #334155; font-size: 14px; }
        .form-control { border-radius: 9px; border: 1px solid #cbd5e1; padding: 10px 14px; font-size: 14px; }
        .form-control:focus { border-color: #2563eb; box-shadow: 0 0 0 3px #dbeafe; }
        
        .btn { border: 0; border-radius: 10px; padding: 11px 17px; font-family: inherit; font-size: 14px; font-weight: 650; cursor: pointer; transition: .2s; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
        .btn-primary { background: #2563eb; color: white; }
        .btn-primary:hover { background: #1d4ed8; color: white; }
        .btn-income { background: #10b981; color: white; }
        .btn-income:hover { background: #059669; color: white; }
        .btn-light { background: #e2e8f0; color: #334155; }
        .btn-light:hover { background: #cbd5e1; }

        .goal-card { display: flex; flex-direction: column; gap: 15px; }
        .goal-header { display: flex; align-items: center; gap: 15px; }
        .goal-icon { width: 50px; height: 50px; display: grid; place-items: center; border-radius: 12px; background: #dcfce7; color: #16a34a; font-size: 22px; }
        .goal-title { font-size: 16px; font-weight: 700; color: #1e293b; margin: 0; }
        .goal-money { font-size: 13px; color: #64748b; margin-top: 4px; }
        .progress { height: 10px; background-color: #e2e8f0; border-radius: 10px; overflow: hidden; }
        .progress-bar { background-color: #10b981; border-radius: 10px; }

        @@media (max-width: 650px) {
            .sidebar { width: 75px; padding: 20px 9px; }
            .brand { justify-content: center; padding: 0; }
            .brand-text, .nav a span { display: none; }
            .nav a { justify-content: center; padding: 13px 5px; }
            .main { padding: 18px 12px; }
            .top-header { padding: 0 15px; }
            .user-name { display: none; }
            .app-footer { flex-direction: column; align-items: flex-start; padding: 20px 15px; }
            .footer-right { align-items: flex-start; }
        }
    </style>
</head>
<body>
    <!-- HEADER -->
    <header class="top-header">
        <a class="brand-top" asp-controller="Home" asp-action="Index">
            <i class="fa-solid fa-wallet"></i> MoneyCare
        </a>
        <div class="user-menu">
            @if (Context.Session.GetInt32("UserId") != null)
            {
                <span class="user-name"><i class="fa-solid fa-circle-user"></i> Xin chào, @(Context.Session.GetString("HoTen") ?? "Người dùng")</span>
                <a href="/Account/Logout" class="btn-logout"><i class="fa-solid fa-arrow-right-from-bracket"></i> Đăng xuất</a>
            }
            else
            {
                <a href="/Account/Login" class="btn-logout">Đăng nhập</a>
                <a href="/Account/Register" class="btn-register"><i class="fa-solid fa-user-plus"></i> Đăng ký</a>
            }
        </div>
    </header>

    <div class="app">
        <!-- Sidebar -->
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-icon"><i class="fa-solid fa-wallet"></i></span>
                <span class="brand-text">MoneyCare</span>
            </a>
            <nav class="nav">
                <a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-table-columns"></i> <span>Tổng quan</span></a>
                <a asp-controller="Home" asp-action="GiaoDich"><i class="fa-solid fa-arrow-right-arrow-left"></i> <span>Thu chi</span></a>
                <a asp-controller="Home" asp-action="NganSach"><i class="fa-solid fa-chart-pie"></i> <span>Ngân sách</span></a>
                <a asp-controller="Home" asp-action="TietKiem" class="active"><i class="fa-solid fa-piggy-bank"></i> <span>Tiết kiệm</span></a>
                <a asp-controller="DanhMuc" asp-action="Index"><i class="fa-solid fa-folder-open"></i> <span>Danh mục</span></a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main">
            <div class="page-header">
                <div class="page-title">
                    <div class="page-title-icon"><i class="fa-solid fa-piggy-bank"></i></div>
                    <div>
                        <h1>Mục tiêu tiết kiệm</h1>
                        <p>Số dư khả dụng: <b>4.900.000đ</b>. Tiền trích vào mục tiêu được trừ khỏi số dư.</p>
                    </div>
                </div>
            </div>

            <!-- Tạo mục tiêu mới -->
            <div class="box mb-4">
                <h2 style="font-size:18px; font-weight:700; color:#1e293b; margin-bottom:20px;">
                    <i class="fa-solid fa-bullseye text-primary"></i> Tạo mục tiêu mới
                </h2>
                <form method="post" action="#" class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label">Tên mục tiêu</label>
                        <input type="text" class="form-control" name="TenMucTieu" maxlength="150" placeholder="Ví dụ: Mua xe máy..." required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Số tiền cần đạt (VNĐ)</label>
                        <input type="number" class="form-control" name="SoTienMucTieu" min="1" placeholder="Ví dụ: 20000000" required>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-plus"></i> Tạo mục tiêu</button>
                    </div>
                </form>
            </div>

            <!-- Danh sách mục tiêu -->
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="box goal-card">
                        <div class="goal-header">
                            <div class="goal-icon"><i class="fa-solid fa-mobile-screen"></i></div>
                            <div class="flex-grow-1">
                                <h3 class="goal-title">Mua điện thoại</h3>
                                <div class="goal-money">1.000.000đ / 10.000.000đ</div>
                            </div>
                            <span style="background:#dcfce7; color:#15803d; padding:6px 12px; border-radius:20px; font-size:12px; font-weight:650;">10%</span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar" role="progressbar" style="width: 10%;" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <form method="post" action="#" class="d-flex gap-2 mt-2">
                            <input type="number" class="form-control" name="SoTien" min="1" placeholder="Nhập số tiền..." required>
                            <button type="submit" name="Loai" value="Nap" class="btn btn-income" style="white-space:nowrap;">Nạp</button>
                            <button type="submit" name="Loai" value="Rut" class="btn btn-light" style="white-space:nowrap;">Rút</button>
                        </form>
                    </div>
                </div>
                
                <div class="col-lg-6">
                    <div class="box goal-card">
                        <div class="goal-header">
                            <div class="goal-icon"><i class="fa-solid fa-shield-halved"></i></div>
                            <div class="flex-grow-1">
                                <h3 class="goal-title">Quỹ khẩn cấp</h3>
                                <div class="goal-money">0đ / 5.000.000đ</div>
                            </div>
                            <span style="background:#f1f5f9; color:#475569; padding:6px 12px; border-radius:20px; font-size:12px; font-weight:650;">0%</span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <form method="post" action="#" class="d-flex gap-2 mt-2">
                            <input type="number" class="form-control" name="SoTien" min="1" placeholder="Nhập số tiền..." required>
                            <button type="submit" name="Loai" value="Nap" class="btn btn-income" style="white-space:nowrap;">Nạp</button>
                            <button type="submit" name="Loai" value="Rut" class="btn btn-light" style="white-space:nowrap;">Rút</button>
                        </form>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="app-footer">
        <div class="footer-left">
            <a class="footer-brand" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-wallet"></i> MoneyCare
            </a>
            <p class="footer-desc">Quản lý thu chi thông minh, xây dựng tương lai tài chính tốt hơn.</p>
        </div>
        <div class="footer-right">
            <div class="footer-links">
                <a href="#">Trang chủ</a> |
                <a href="#">Giới thiệu</a> |
                <a href="#">Liên hệ</a>
            </div>
            <div class="footer-copy">
                &copy; 2026 MoneyCare. All rights reserved.
            </div>
        </div>
    </footer>
</body>
</html>