@model TietKiemTienDoViewModel
@using System.Globalization
@{
    Layout = null;
    ViewData["Title"] = "Tiết kiệm";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    string Tien(decimal tien) => tien.ToString("#,0.##", vi) + " đ";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tiết kiệm - MoneyCare</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: "Segoe UI", Arial, sans-serif; background: #f4f7fc; color: #172554; display: flex; flex-direction: column; min-height: 100vh; }
        .app { display: flex; flex: 1; }
        
        /* --- HEADER --- */
        .top-header { display: flex; justify-content: space-between; align-items: center; height: 70px; padding: 0 32px; background: white; border-bottom: 1px solid #e2e8f0; flex-shrink: 0; }
        .brand-top { font-size: 24px; font-weight: 750; color: #2563eb; text-decoration: none; display: flex; align-items: center; gap: 10px; }
        .user-menu { display: flex; align-items: center; gap: 15px; }
        .user-name { color: #334155; font-weight: 600; font-size: 15px; }
        .user-name i { color: #2563eb; margin-right: 5px; font-size: 18px; }
        
        .btn-logout { border: 1px solid #2563eb; color: #2563eb; background: transparent; padding: 8px 16px; border-radius: 8px; font-weight: 650; font-size: 14px; text-decoration: none; transition: 0.2s; display: flex; align-items: center; gap: 8px; }
        .btn-logout:hover { background: #2563eb; color: white; }
        
        .btn-register { border: 1px solid #2563eb; background: #2563eb; color: white; padding: 8px 16px; border-radius: 8px; font-weight: 650; font-size: 14px; text-decoration: none; transition: 0.2s; display: flex; align-items: center; gap: 8px; }
        .btn-register:hover { background: #1d4ed8; border-color: #1d4ed8; color: white; }

        /* --- FOOTER --- */
        .app-footer { background: white; padding: 24px 36px; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; flex-shrink: 0; }
        .footer-left { display: flex; flex-direction: column; gap: 8px; }
        .footer-brand { font-size: 22px; font-weight: 750; color: #2563eb; text-decoration: none; display: flex; align-items: center; gap: 10px; }
        .footer-desc { margin: 0; color: #64748b; font-size: 14px; }
        .footer-right { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
        .footer-links { display: flex; gap: 12px; font-size: 14px; color: #cbd5e1; }
        .footer-links a { color: #64748b; text-decoration: none; transition: 0.2s; }
        .footer-links a:hover { color: #2563eb; }
        .footer-copy { color: #94a3b8; font-size: 13px; }

        /* Sidebar */
        .sidebar { width: 250px; flex-shrink: 0; padding: 25px 16px; background: linear-gradient(180deg, #172f59, #1e40af); color: white; }
        .brand { display: flex; align-items: center; gap: 12px; margin: 0 0 38px; padding: 0 8px; color: white; text-decoration: none; font-size: 22px; font-weight: 750; }
        .brand-icon { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 12px; background: #10b981; font-size: 20px; }
        .nav a { display: flex; align-items: center; gap: 14px; padding: 13px 14px; margin-bottom: 7px; border-radius: 10px; color: #dbeafe; text-decoration: none; font-size: 15px; transition: .2s; }
        .nav a i { width: 21px; text-align: center; font-size: 17px; }
        .nav a:hover, .nav a.active { background: #3565c5; color: white; }
        .nav a.active { box-shadow: inset 4px 0 #fbbf24; }

        /* Main content */
        .main { flex: 1; min-width: 0; padding: 32px 36px; }
        .page-header { display: flex; justify-content: space-between; align-items: center; gap: 15px; margin-bottom: 25px; }
        .page-title { display: flex; align-items: center; gap: 15px; }
        .page-title-icon { width: 54px; height: 54px; display: grid; place-items: center; border-radius: 14px; background: #dbeafe; color: #2563eb; font-size: 27px; }
        .page-title h1 { margin: 0; font-size: 27px; font-weight: 750; color: #172554; }
        .page-title p { margin: 5px 0 0; color: #64748b; font-size: 14px; }

        /* Form Box & Cards */
        .box { background: white; border: 1px solid #e2e8f0; border-radius: 15px; padding: 25px; box-shadow: 0 3px 12px rgba(15, 23, 42, .04); }
        .form-label { font-weight: 600; color: #334155; font-size: 14px; }
        .form-control { border-radius: 9px; border: 1px solid #cbd5e1; padding: 10px 14px; font-size: 14px; }
        .form-control:focus { border-color: #2563eb; box-shadow: 0 0 0 3px #dbeafe; }
        
        .btn { border: 0; border-radius: 10px; padding: 11px 17px; font-family: inherit; font-size: 14px; font-weight: 650; cursor: pointer; transition: .2s; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
        .btn-primary { background: #2563eb; color: white; }
        .btn-primary:hover { background: #1d4ed8; color: white; }
        .btn-income { background: #10b981; color: white; }
        .btn-income:hover { background: #059669; color: white; }
        .btn-light { background: #e2e8f0; color: #334155; }
        .btn-light:hover { background: #cbd5e1; }

        .goal-card { display: flex; flex-direction: column; gap: 15px; }
        .goal-header { display: flex; align-items: center; gap: 15px; }
        .goal-icon { width: 50px; height: 50px; display: grid; place-items: center; border-radius: 12px; background: #dcfce7; color: #16a34a; font-size: 22px; }
        .goal-title { font-size: 16px; font-weight: 700; color: #1e293b; margin: 0; }
        .goal-money { font-size: 13px; color: #64748b; margin-top: 4px; }
        .progress { height: 10px; background-color: #e2e8f0; border-radius: 10px; overflow: hidden; }
        .progress-bar { background-color: #10b981; border-radius: 10px; }

        .goal-header > div { min-width: 0; }
        .goal-title { overflow-wrap: anywhere; }
        .goal-amounts { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px; margin: 0; }
        .goal-amounts dt { color: #475569; font-size: .8rem; }
        .goal-amounts dd { color: #172554; font-weight: 700; margin: 0; overflow-wrap: anywhere; }
        .goal-meter-label { color: #334155; font-size: .85rem; font-weight: 600; }
        .goal-tools { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
        .history-note { min-width: 12rem; overflow-wrap: anywhere; }
        .money-change { white-space: nowrap; font-weight: 650; }
        .btn-income { background: #047857; }
        .btn-income:hover { background: #065f46; }

        @@media (max-width: 650px) {
            .sidebar { width: 75px; padding: 20px 9px; }
            .brand { justify-content: center; padding: 0; }
            .brand-text, .nav a span { display: none; }
            .nav a { justify-content: center; padding: 13px 5px; }
            .main { padding: 18px 12px; }
            .top-header { padding: 0 15px; }
            .user-name { display: none; }
            .app-footer { flex-direction: column; align-items: flex-start; padding: 20px 15px; }
            .footer-right { align-items: flex-start; }
        }
    </style>
</head>
<body>
    <!-- HEADER -->
    <header class="top-header">
        <a class="brand-top" asp-controller="Home" asp-action="Index">
            <i class="fa-solid fa-wallet"></i> MoneyCare
        </a>
        <div class="user-menu">
            @if (Context.Session.GetInt32("UserId") != null)
            {
                <span class="user-name"><i class="fa-solid fa-circle-user"></i> Xin chào, @(Context.Session.GetString("HoTen") ?? "Người dùng")</span>
                <a href="/Account/Logout" class="btn-logout"><i class="fa-solid fa-arrow-right-from-bracket"></i> Đăng xuất</a>
            }
            else
            {
                <a href="/Account/Login" class="btn-logout">Đăng nhập</a>
                <a href="/Account/Register" class="btn-register"><i class="fa-solid fa-user-plus"></i> Đăng ký</a>
            }
        </div>
    </header>

    <div class="app">
        <!-- Sidebar -->
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-icon"><i class="fa-solid fa-wallet"></i></span>
                <span class="brand-text">MoneyCare</span>
            </a>
            <nav class="nav">
                <a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-table-columns"></i> <span>Tổng quan</span></a>
                <a asp-controller="GiaoDich" asp-action="Index"><i class="fa-solid fa-arrow-right-arrow-left"></i> <span>Thu chi</span></a>
                <a asp-controller="Home" asp-action="NganSach"><i class="fa-solid fa-chart-pie"></i> <span>Ngân sách</span></a>
                <a asp-controller="TietKiem" asp-action="Index" class="active" aria-current="page"><i class="fa-solid fa-piggy-bank"></i> <span>Tiết kiệm</span></a>
                <a asp-controller="DanhMuc" asp-action="Index"><i class="fa-solid fa-folder-open"></i> <span>Danh mục</span></a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main">
            <div class="page-header">
                <div class="page-title">
                    <div class="page-title-icon"><i class="fa-solid fa-piggy-bank"></i></div>
                    <div>
                        <h1>Mục tiêu tiết kiệm</h1>
                        <p>Theo dõi số tiền đã tích lũy và lịch sử nạp, rút của từng mục tiêu.</p>
                    </div>
                </div>
            </div>

            @if (TempData["TietKiemSuccess"] is string thanhCong)
            {
                <p class="alert alert-success" role="status">@thanhCong</p>
            }
            @if (TempData["TietKiemError"] is string loi)
            {
                <p class="alert alert-danger" role="alert">@loi</p>
            }

            <section class="box mb-4" aria-labelledby="so-du-kha-dung">
                <h2 id="so-du-kha-dung" class="h6 mb-1">Số dư khả dụng để nạp</h2>
                <strong class="fs-4 @(Model.SoDuKhaDung < 0 ? "text-danger" : "text-primary")">@Tien(Model.SoDuKhaDung)</strong>
                <p class="small text-muted mb-0">Tổng Thu trừ tổng Chi và số tiền đang giữ trong các mục tiêu. Nạp hoặc rút không làm thay đổi chi tiêu ngân sách.</p>
            </section>

            <section class="box mb-4" aria-labelledby="tao-muc-tieu">
                <h2 id="tao-muc-tieu" class="h5 mb-3"><i class="fa-solid fa-bullseye text-primary" aria-hidden="true"></i> Tạo mục tiêu mới</h2>
                <form asp-controller="TietKiem" asp-action="TaoMucTieu" method="post" class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label for="ten-muc-tieu" class="form-label">Tên mục tiêu</label>
                        <input id="ten-muc-tieu" type="text" class="form-control" name="TenMucTieu" maxlength="150" required />
                    </div>
                    <div class="col-md-4">
                        <label for="tien-muc-tieu" class="form-label">Số tiền cần đạt (VNĐ)</label>
                        <input id="tien-muc-tieu" type="number" class="form-control" name="SoTienMucTieu" min="0.01" step="0.01" required />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-plus" aria-hidden="true"></i> Tạo mục tiêu</button>
                    </div>
                </form>
            </section>

            <section aria-labelledby="danh-sach-muc-tieu">
                <h2 id="danh-sach-muc-tieu" class="h5 mb-3">Mục tiêu của bạn</h2>
                @if (Model.MucTieu.Count == 0)
                {
                    <p class="box">Bạn chưa có mục tiêu tiết kiệm. Tạo mục tiêu đầu tiên bằng biểu mẫu phía trên.</p>
                }
                <div class="row g-3">
                    @foreach (var mucTieu in Model.MucTieu)
                    {
                        bool daHuy = QuyTacTietKiem.DaHuy(mucTieu.TrangThai);
                        bool hoanThanh = QuyTacTietKiem.TrangThaiTheoSoDu(mucTieu.SoTienHienTai, mucTieu.SoTienMucTieu) == QuyTacTietKiem.HoanThanh;
                        decimal phanTram = QuyTacTietKiem.TinhPhanTram(mucTieu.SoTienHienTai, mucTieu.SoTienMucTieu);
                        string doRong = phanTram.ToString("0.##", CultureInfo.InvariantCulture);
                        string phanTramViet = phanTram.ToString("0.##", vi) + "%";
                        string trangThai = daHuy ? "Đã hủy" : hoanThanh ? "Hoàn thành" : "Đang thực hiện";
                        string mau = daHuy ? "text-bg-secondary" : hoanThanh ? "text-bg-success" : "text-bg-primary";
                        <div class="col-xl-6">
                            <article id="muc-tieu-@mucTieu.MaMucTieu" class="box goal-card h-100">
                                <header class="goal-header">
                                    <span class="goal-icon" aria-hidden="true"><i class="fa-solid fa-bullseye"></i></span>
                                    <div class="flex-grow-1">
                                        <h3 class="goal-title">@mucTieu.TenMucTieu</h3>
                                        <span class="badge @mau mt-1">@trangThai</span>
                                    </div>
                                </header>
                                <dl class="goal-amounts">
                                    <div><dt>Hiện có</dt><dd>@Tien(mucTieu.SoTienHienTai)</dd></div>
                                    <div><dt>Số tiền cần đạt</dt><dd>@Tien(mucTieu.SoTienMucTieu)</dd></div>
                                    <div><dt>Còn thiếu</dt><dd>@Tien(Math.Max(0, mucTieu.SoTienMucTieu - mucTieu.SoTienHienTai))</dd></div>
                                </dl>
                                <div>
                                    <div class="d-flex justify-content-between goal-meter-label mb-1"><span>Tiến độ</span><strong>@phanTramViet</strong></div>
                                    <div class="progress" role="progressbar" aria-label="Tiến độ @mucTieu.TenMucTieu"
                                         aria-valuenow="@doRong" aria-valuemin="0" aria-valuemax="100" aria-valuetext="@phanTramViet">
                                        <div class="progress-bar" style="width: @(doRong)%;"></div>
                                    </div>
                                </div>

                                @if (!daHuy)
                                {
                                    <form asp-controller="TietKiem" asp-action="NapRut" method="post" class="row g-2">
                                        <input type="hidden" name="MaMucTieu" value="@mucTieu.MaMucTieu" />
                                        <div class="col-sm-6">
                                            <label for="so-tien-@mucTieu.MaMucTieu" class="form-label">Số tiền (VNĐ)</label>
                                            <input id="so-tien-@mucTieu.MaMucTieu" type="number" class="form-control" name="SoTien" min="0.01" step="0.01" required />
                                        </div>
                                        <div class="col-sm-6">
                                            <label for="ghi-chu-@mucTieu.MaMucTieu" class="form-label">Ghi chú (tùy chọn)</label>
                                            <input id="ghi-chu-@mucTieu.MaMucTieu" type="text" class="form-control" name="GhiChu" maxlength="300" />
                                        </div>
                                        <div class="col-12 goal-tools mt-3">
                                            <button type="submit" name="Loai" value="Nap" class="btn btn-income">Nạp tiền</button>
                                            <button type="submit" name="Loai" value="Rut" class="btn btn-light" disabled="@(mucTieu.SoTienHienTai <= 0)">Rút tiền</button>
                                        </div>
                                    </form>
                                }
                                <div class="goal-tools">
                                    <a asp-controller="TietKiem" asp-action="Index" asp-route-id="@mucTieu.MaMucTieu"
                                       asp-fragment="lich-su" class="btn btn-light">Xem lịch sử</a>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            </section>

            @if (Model.MucTieuLichSu is { } mucTieuLichSu)
            {
                <section class="box mt-4" id="lich-su" aria-labelledby="tieu-de-lich-su">
                    <h2 id="tieu-de-lich-su" class="h5 mb-3">Lịch sử nạp và rút – @mucTieuLichSu.TenMucTieu</h2>
                    @if (Model.LichSu.Count == 0)
                    {
                        <p class="mb-0 text-muted">Mục tiêu này chưa có giao dịch.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead><tr>
                                    <th scope="col">Thời gian</th>
                                    <th scope="col">Loại</th>
                                    <th scope="col" class="text-end">Số tiền</th>
                                    <th scope="col">Ghi chú</th>
                                </tr></thead>
                                <tbody>
                                    @foreach (var dong in Model.LichSu)
                                    {
                                        bool rut = dong.SoTien < 0;
                                        <tr>
                                            <td>@dong.NgayGiaoDich.ToString("dd/MM/yyyy HH:mm:ss", vi)</td>
                                            <td>@(rut ? "Rút tiền" : "Nạp tiền")</td>
                                            <td class="text-end money-change @(rut ? "text-danger" : "text-success")">
                                                @(rut ? "−" : "+")@Tien(Math.Abs(dong.SoTien))
                                            </td>
                                            <td class="history-note">@(dong.GhiChu ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (Model.TongTrang > 1)
                        {
                            <nav class="goal-tools mt-3" aria-label="Phân trang lịch sử">
                                @if (Model.Trang > 1)
                                {
                                    <a asp-action="Index" asp-route-id="@mucTieuLichSu.MaMucTieu" asp-route-trang="@(Model.Trang - 1)" asp-fragment="lich-su" class="btn btn-light">Trang trước</a>
                                }
                                <span>Trang @Model.Trang / @Model.TongTrang</span>
                                @if (Model.Trang < Model.TongTrang)
                                {
                                    <a asp-action="Index" asp-route-id="@mucTieuLichSu.MaMucTieu" asp-route-trang="@(Model.Trang + 1)" asp-fragment="lich-su" class="btn btn-light">Trang sau</a>
                                }
                            </nav>
                        }
                    }
                </section>
            }
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="app-footer">
        <div class="footer-left">
            <a class="footer-brand" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-wallet"></i> MoneyCare
            </a>
            <p class="footer-desc">Quản lý thu chi thông minh, xây dựng tương lai tài chính tốt hơn.</p>
        </div>
        <div class="footer-right">
            <div class="footer-links">
                <a href="#">Trang chủ</a> |
                <a href="#">Giới thiệu</a> |
                <a href="#">Liên hệ</a>
            </div>
            <div class="footer-copy">
                &copy; 2026 MoneyCare. All rights reserved.
            </div>
        </div>
    </footer>
</body>
</html>