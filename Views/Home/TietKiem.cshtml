<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tiết kiệm - MoneyCare</title>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="css/site.css" rel="stylesheet">
</head>
<body>
<div class="app">
  <aside class="sidebar">

    <a class="brand"
       asp-controller="Home"
       asp-action="Index">
        <i class="bi bi-wallet2"></i> MoneyCare
    </a>

    <a class="item" asp-controller="Home" asp-action="Index">
        <i class="bi bi-grid-1x2-fill"></i> Tổng quan
    </a>

    <a class="item" asp-controller="Home" asp-action="GiaoDich">
        <i class="bi bi-arrow-left-right"></i> Thu chi
    </a>

    <a class="item" asp-controller="Home" asp-action="NganSach">
        <i class="bi bi-pie-chart-fill"></i> Ngân sách
    </a>

    <a class="item" asp-controller="Home" asp-action="TietKiem">
        <i class="bi bi-piggy-bank-fill"></i> Tiết kiệm
    </a>

</aside>
  <main class="content">
    <h1 class="page-title">Mục tiêu tiết kiệm</h1>
    <p class="page-sub">Số dư khả dụng: <b>4.900.000đ</b>. Tiền trích vào mục tiêu được trừ khỏi số dư.</p>

    <div class="box mb-4">
      <h2>Tạo mục tiêu mới</h2>
      <form method="post" action="#" class="row g-3 align-items-end">
        <div class="col-md-5"><label class="form-label">Tên mục tiêu</label>
          <input type="text" class="form-control" name="TenMucTieu" maxlength="150" required></div>
        <div class="col-md-4"><label class="form-label">Số tiền cần đạt (đ)</label>
          <input type="number" class="form-control" name="SoTienMucTieu" min="1" required></div>
        <div class="col-md-3"><button type="submit" class="btn btn-main w-100">Tạo mục tiêu</button></div>
      </form>
    </div>

    <div class="row g-4">
      <div class="col-lg-6"><div class="box">
        <div class="d-flex align-items-center gap-3 mb-3"><span class="ico ico-save"><i class="bi bi-phone-fill"></i></span>
          <div class="flex-grow-1"><b class="fs-6">Mua điện thoại</b><div class="text-secondary small">1.000.000đ / 10.000.000đ</div></div>
          <span class="badge-soft soft-save">10%</span></div>
        <div class="progress mb-4"><div class="progress-bar bar-save" style="width:10%"></div></div>
        <form method="post" action="#" class="d-flex gap-2">
          <input type="number" class="form-control" name="SoTien" min="1" placeholder="Số tiền (đ)" required>
          <button type="submit" name="Loai" value="Nap" class="btn btn-income">Nạp</button>
          <button type="submit" name="Loai" value="Rut" class="btn btn-light border">Rút</button>
        </form>
      </div></div>
      <div class="col-lg-6"><div class="box">
        <div class="d-flex align-items-center gap-3 mb-3"><span class="ico ico-save"><i class="bi bi-shield-check"></i></span>
          <div class="flex-grow-1"><b class="fs-6">Quỹ khẩn cấp</b><div class="text-secondary small">0đ / 5.000.000đ</div></div>
          <span class="badge-soft soft-save">0%</span></div>
        <div class="progress mb-4"><div class="progress-bar bar-save" style="width:0%"></div></div>
        <form method="post" action="#" class="d-flex gap-2">
          <input type="number" class="form-control" name="SoTien" min="1" placeholder="Số tiền (đ)" required>
          <button type="submit" name="Loai" value="Nap" class="btn btn-income">Nạp</button>
          <button type="submit" name="Loai" value="Rut" class="btn btn-light border">Rút</button>
        </form>
      </div></div>
    </div>
  </main>
</div>
</body>
</html>