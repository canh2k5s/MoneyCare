
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MoneyCare</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- CSS riêng -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MoneyCare.styles.css" asp-append-version="true" />
</head>

<body>

    <!-- HEADER -->
    <header class="main-header">
        <nav class="navbar">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold text-primary"
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="bi bi-wallet2"></i>
                    MoneyCare
                </a>

                <div class="d-flex align-items-center gap-2">

                    @if (Context.Session.GetInt32("UserId") != null)
                    {
                        <span class="fw-semibold text-dark">
                            <i class="bi bi-person-circle text-primary"></i>
                            Xin chào, @Context.Session.GetString("HoTen")
                        </span>

                        <a class="btn btn-outline-primary"
                           asp-controller="Account"
                           asp-action="Logout">
                            <i class="bi bi-box-arrow-right"></i>
                            Đăng xuất
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary"
                           asp-controller="Account"
                           asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i>
                            Đăng nhập
                        </a>

                        <a class="btn btn-primary"
                           asp-controller="Account"
                           asp-action="Register">
                            <i class="bi bi-person-plus"></i>
                            Đăng ký
                        </a>
                    }

                </div>

            </div>
        </nav>
    </header>

    <!-- NỘI DUNG CÁC TRANG -->
    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="main-footer">
        <div class="container-fluid">
            <div class="row align-items-center">

                <div class="col-md-6">
                    <h5 class="footer-brand">
                        <i class="bi bi-wallet2"></i> MoneyCare
                    </h5>

                    <p class="mb-0">
                        Quản lý thu chi thông minh,
                        xây dựng tương lai tài chính tốt hơn.
                    </p>
                </div>

                <div class="col-md-6 text-md-end mt-3 mt-md-0">
                    <p class="mb-1">
                        <a asp-controller="Home" asp-action="Index">
                            Trang chủ
                        </a>
                        <span class="mx-2">|</span>
                        <a href="#">Giới thiệu</a>
                        <span class="mx-2">|</span>
                        <a href="#">Liên hệ</a>
                    </p>

                    <small>
                        © 2026 MoneyCare. All rights reserved.
                    </small>
                </div>

            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
