@{
    Layout = null;
    ViewData["Title"] = "Thu chi";
}

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Thu chi - MoneyCare</title>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <style>
      * { box-sizing: border-box; }
      body { margin: 0; font-family: "Segoe UI", Arial, sans-serif; background: #f4f7fc; color: #172554; display: flex; flex-direction: column; min-height: 100vh; }
      .app { display: flex; flex: 1; }

      /* --- HEADER --- */
      .top-header { display: flex; justify-content: space-between; align-items: center; height: 70px; padding: 0 32px; background: white; border-bottom: 1px solid #e2e8f0; flex-shrink: 0; }
      .brand-top { font-size: 24px; font-weight: 750; color: #2563eb; text-decoration: none; display: flex; align-items: center; gap: 10px; }
      .user-menu { display: flex; align-items: center; gap: 15px; }
      .user-name { color: #334155; font-weight: 600; font-size: 15px; }
      .user-name i { color: #2563eb; margin-right: 5px; font-size: 18px; }
      
      .btn-logout { border: 1px solid #2563eb; color: #2563eb; background: transparent; padding: 8px 16px; border-radius: 8px; font-weight: 650; font-size: 14px; text-decoration: none; transition: 0.2s; display: flex; align-items: center; gap: 8px; }
      .btn-logout:hover { background: #2563eb; color: white; }
      
      .btn-register { border: 1px solid #2563eb; background: #2563eb; color: white; padding: 8px 16px; border-radius: 8px; font-weight: 650; font-size: 14px; text-decoration: none; transition: 0.2s; display: flex; align-items: center; gap: 8px; }
      .btn-register:hover { background: #1d4ed8; border-color: #1d4ed8; color: white; }

      /* --- SIDEBAR --- */
      .sidebar { width: 250px !important; flex-shrink: 0; padding: 25px 16px !important; background: linear-gradient(180deg, #172f59, #1e40af) !important; color: white !important; min-height: 100%; }
      .brand { display: flex !important; align-items: center; gap: 12px; margin: 0 0 38px !important; padding: 0 8px !important; color: white !important; text-decoration: none !important; font-size: 22px !important; font-weight: 750 !important; }
      .brand-icon { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 12px; background: #10b981; font-size: 20px; }
      .nav a { display: flex !important; align-items: center; gap: 14px; padding: 13px 14px !important; margin-bottom: 7px !important; border-radius: 10px !important; color: #dbeafe !important; text-decoration: none !important; font-size: 15px !important; transition: .2s; }
      .nav a i { width: 21px; text-align: center; font-size: 17px; }
      .nav a:hover, .nav a.active { background: #3565c5 !important; color: white !important; }
      .nav a.active { box-shadow: inset 4px 0 #fbbf24 !important; }

      /* --- MAIN CONTENT --- */
      .main { flex: 1; min-width: 0; padding: 32px 36px; }
      .page-title { margin: 0 0 5px; font-size: 27px; font-weight: 750; color: #172554; }
      .page-sub { color: #64748b; font-size: 14px; margin-bottom: 25px; }

      /* --- BOX & FORMS --- */
      .box { background: white; border: 1px solid #e2e8f0; border-radius: 15px; padding: 25px; box-shadow: 0 3px 12px rgba(15, 23, 42, .04); position: relative; overflow: hidden; }
      .box h2 { font-size: 18px; font-weight: 700; color: #1e293b; margin-bottom: 20px; }
      .form-top { position: absolute; top: 0; left: 0; right: 0; height: 5px; }
      .form-label { font-weight: 600; color: #334155; font-size: 14px; }
      .form-control, .form-select { border-radius: 9px; border: 1px solid #cbd5e1; padding: 10px 14px; font-size: 14px; }
      .form-control:focus, .form-select:focus { border-color: #2563eb; box-shadow: 0 0 0 3px #dbeafe; }
      
      .btn { border: 0; border-radius: 10px; padding: 11px 17px; font-family: inherit; font-size: 14px; font-weight: 650; cursor: pointer; transition: .2s; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
      .btn-spent { background: #f97316; color: white; } .btn-spent:hover { background: #ea580c; color: white; }
      .btn-income { background: #10b981; color: white; } .btn-income:hover { background: #059669; color: white; }
      .btn-main { background: #2563eb; color: white; } .btn-main:hover { background: #1d4ed8; color: white; }

      /* --- TABLE --- */
      .table-wrap { background: white; border: 1px solid #e2e8f0; border-radius: 15px; box-shadow: 0 3px 12px rgba(15, 23, 42, .04); padding: 20px; margin-top: 24px; }
      .table th { font-size: 12px; font-weight: 750; color: #475569; text-transform: uppercase; border-bottom: 2px solid #edf2ff; padding-bottom: 12px; }
      .table td { font-size: 14px; vertical-align: middle; padding: 15px 8px; border-top: 1px solid #edf0f5; }
      
      /* --- FOOTER --- */
      .app-footer { background: white; padding: 24px 36px; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; flex-shrink: 0; }
      .footer-left { display: flex; flex-direction: column; gap: 8px; }
      .footer-brand { font-size: 22px; font-weight: 750; color: #2563eb; text-decoration: none; display: flex; align-items: center; gap: 10px; }
      .footer-desc { margin: 0; color: #64748b; font-size: 14px; }
      .footer-right { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
      .footer-links { display: flex; gap: 12px; font-size: 14px; color: #cbd5e1; }
      .footer-links a { color: #64748b; text-decoration: none; transition: 0.2s; }
      .footer-links a:hover { color: #2563eb; }
      .footer-copy { color: #94a3b8; font-size: 13px; }

      @@media (max-width: 650px) {
          .sidebar { width: 75px !important; padding: 20px 9px !important; }
          .brand { justify-content: center; padding: 0 !important; }
          .brand-text, .nav a span { display: none; }
          .nav a { justify-content: center; padding: 13px 5px !important; }
          .main { padding: 18px 12px; }
          .app-footer { flex-direction: column; align-items: flex-start; padding: 20px 15px; }
          .footer-right { align-items: flex-start; }
          .top-header { padding: 0 15px; }
          .user-name { display: none; }
      }
  </style>
</head>
<body>
  <!-- HEADER -->
  <header class="top-header">
      <a class="brand-top" asp-controller="Home" asp-action="Index">
          <i class="fa-solid fa-wallet"></i> MoneyCare
      </a>
      
      <div class="user-menu">
          @if (Context.Session.GetInt32("UserId") != null)
          {
              <span class="user-name"><i class="fa-solid fa-circle-user"></i> Xin chào, @(Context.Session.GetString("HoTen") ?? "Người dùng")</span>
              <a href="/Account/Logout" class="btn-logout"><i class="fa-solid fa-arrow-right-from-bracket"></i> Đăng xuất</a>
          }
          else
          {
              <a href="/Account/Login" class="btn-logout">Đăng nhập</a>
              <a href="/Account/Register" class="btn-register"><i class="fa-solid fa-user-plus"></i> Đăng ký</a>
          }
      </div>
  </header>

  <div class="app">
    <!-- SIDEBAR -->
    <aside class="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-icon"><i class="fa-solid fa-wallet"></i></span>
            <span class="brand-text">MoneyCare</span>
        </a>
        <nav class="nav">
            <a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-table-columns"></i> <span>Tổng quan</span></a>
            <a asp-controller="GiaoDich" asp-action="Index" class="active"><i class="fa-solid fa-arrow-right-arrow-left"></i> <span>Thu chi</span></a>
            <a asp-controller="Home" asp-action="NganSach"><i class="fa-solid fa-chart-pie"></i> <span>Ngân sách</span></a>
            <a asp-controller="Home" asp-action="TietKiem"><i class="fa-solid fa-piggy-bank"></i> <span>Tiết kiệm</span></a>
            <a asp-controller="DanhMuc" asp-action="Index"><i class="fa-solid fa-folder-open"></i> <span>Danh mục</span></a>
        </nav>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main">
      <h1 class="page-title">Quản lý Thu Chi</h1>
      <p class="page-sub">Nhập, lọc và xem lại các khoản thu chi.</p>

      <div class="row g-4 mb-4">
        <!-- Form Thêm Chi -->
        <div class="col-lg-6">
          <div class="box">
            <div class="form-top" style="background:linear-gradient(90deg,#fb923c,#f97316)"></div>
            <h2><i class="bi bi-arrow-up-circle-fill text-warning me-2"></i>Thêm khoản chi</h2>
            <form method="post" action="#">
              <div class="row g-3">
                <div class="col-sm-6"><label class="form-label">Danh mục chi</label>
                  <select class="form-select" name="MaDanhMuc" required><option>Ăn uống</option><option>Phòng trọ</option><option>Điện, nước, mạng</option><option>Đi lại</option></select></div>
                <div class="col-sm-6"><label class="form-label">Số tiền (đ)</label>
                  <input type="number" class="form-control" name="SoTien" min="1" placeholder="50000" required></div>
                <div class="col-sm-6"><label class="form-label">Ngày</label>
                  <input type="date" class="form-control" name="NgayGiaoDich" value="2026-10-20" required></div>
                <div class="col-sm-6"><label class="form-label">Ghi chú</label>
                  <input type="text" class="form-control" name="GhiChu" maxlength="500" placeholder="Ăn trưa..."></div>
              </div>
              <div class="d-flex align-items-center justify-content-between mt-4">
                <button type="submit" class="btn btn-spent"><i class="bi bi-plus-lg me-1"></i>Lưu khoản chi</button>
                <small class="text-secondary">Ăn uống còn 1.200.000đ</small>
              </div>
            </form>
          </div>
        </div>
        
        <!-- Form Thêm Thu -->
        <div class="col-lg-6">
          <div class="box">
            <div class="form-top" style="background:linear-gradient(90deg,#34d399,#10b981)"></div>
            <h2><i class="bi bi-arrow-down-circle-fill text-success me-2"></i>Thêm khoản thu</h2>
            <form method="post" action="#">
              <div class="row g-3">
                <div class="col-sm-6"><label class="form-label">Danh mục thu</label>
                  <select class="form-select" name="MaDanhMuc" required><option>Lương</option></select></div>
                <div class="col-sm-6"><label class="form-label">Số tiền (đ)</label>
                  <input type="number" class="form-control" name="SoTien" min="1" placeholder="8000000" required></div>
                <div class="col-sm-6"><label class="form-label">Ngày</label>
                  <input type="date" class="form-control" name="NgayGiaoDich" value="2026-10-20" required></div>
                <div class="col-sm-6"><label class="form-label">Ghi chú</label>
                  <input type="text" class="form-control" name="GhiChu" maxlength="500" placeholder="Lương tháng 10"></div>
              </div>
              <div class="mt-4"><button type="submit" class="btn btn-income"><i class="bi bi-plus-lg me-1"></i>Lưu khoản thu</button></div>
            </form>
          </div>
        </div>
      </div>

      <!-- Lịch sử giao dịch -->
      <div class="table-wrap">
        <h2 style="font-size:18px; font-weight:700; color:#1e293b; margin-bottom:20px;">
            <i class="bi bi-clock-history me-2"></i>Lịch sử giao dịch
        </h2>
        <form method="get" action="#" class="row g-2 mb-3">
          <div class="col-md-6"><div class="input-group"><span class="input-group-text bg-white border-end-0" style="border-radius:12px 0 0 12px"><i class="bi bi-search"></i></span><input type="text" class="form-control border-start-0" name="tuKhoa" placeholder="Tìm theo ghi chú" style="border-radius:0 12px 12px 0"></div></div>
          <div class="col-md-3"><select class="form-select" name="loai"><option value="">Tất cả</option><option>Thu</option><option>Chi</option></select></div>
          <div class="col-md-3"><button type="submit" class="btn btn-main w-100"><i class="fa-solid fa-filter"></i> Tìm kiếm</button></div>
        </form>
        
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead><tr><th>Ngày</th><th>Danh mục</th><th>Ghi chú</th><th class="text-end">Số tiền</th><th></th></tr></thead>
            <tbody>
            <tr><td class="text-secondary">18/10/2026</td><td><span class="ico ico-sm ico-food me-2"><i class="bi bi-cup-hot-fill"></i></span>Ăn uống</td><td>Ăn trưa tuần 3</td><td class="text-end fw-bold text-danger">−250.000đ</td><td class="text-end text-nowrap"><a href="#" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a> <a href="#" class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></a></td></tr>
            <tr><td class="text-secondary">11/10/2026</td><td><span class="ico ico-sm ico-food me-2"><i class="bi bi-cup-hot-fill"></i></span>Ăn uống</td><td>Ăn trưa tuần 2</td><td class="text-end fw-bold text-danger">−250.000đ</td><td class="text-end text-nowrap"><a href="#" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a> <a href="#" class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></a></td></tr>
            <tr><td class="text-secondary">07/10/2026</td><td><span class="ico ico-sm ico-move me-2"><i class="bi bi-bus-front-fill"></i></span>Đi lại</td><td>Xăng xe</td><td class="text-end fw-bold text-danger">−100.000đ</td><td class="text-end text-nowrap"><a href="#" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a> <a href="#" class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></a></td></tr>
            <tr><td class="text-secondary">05/10/2026</td><td><span class="ico ico-sm ico-bill me-2"><i class="bi bi-lightning-charge-fill"></i></span>Điện, nước, mạng</td><td>Điện nước</td><td class="text-end fw-bold text-danger">−200.000đ</td><td class="text-end text-nowrap"><a href="#" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a> <a href="#" class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></a></td></tr>
            <tr><td class="text-secondary">04/10/2026</td><td><span class="ico ico-sm ico-food me-2"><i class="bi bi-cup-hot-fill"></i></span>Ăn uống</td><td>Ăn trưa tuần 1</td><td class="text-end fw-bold text-danger">−300.000đ</td><td class="text-end text-nowrap"><a href="#" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a> <a href="#" class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></a></td></tr>
            <tr><td class="text-secondary">02/10/2026</td><td><span class="ico ico-sm ico-home me-2"><i class="bi bi-house-door-fill"></i></span>Phòng trọ</td><td>Tiền phòng</td><td class="text-end fw-bold text-danger">−1.000.000đ</td><td class="text-end text-nowrap"><a href="#" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a> <a href="#" class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></a></td></tr>
            <tr><td class="text-secondary">01/10/2026</td><td><span class="ico ico-sm ico-in me-2"><i class="bi bi-cash-coin"></i></span>Lương</td><td>Lương tháng 10</td><td class="text-end fw-bold text-success">+8.000.000đ</td><td class="text-end text-nowrap"><a href="#" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a> <a href="#" class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></a></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <!-- FOOTER -->
  <footer class="app-footer">
      <div class="footer-left">
          <a class="footer-brand" asp-controller="Home" asp-action="Index">
              <i class="fa-solid fa-wallet"></i> MoneyCare
          </a>
          <p class="footer-desc">Quản lý thu chi thông minh, xây dựng tương lai tài chính tốt hơn.</p>
      </div>
      <div class="footer-right">
          <div class="footer-links">
              <a href="#">Trang chủ</a> |
              <a href="#">Giới thiệu</a> |
              <a href="#">Liên hệ</a>
          </div>
          <div class="footer-copy">
              &copy; 2026 MoneyCare. All rights reserved.
          </div>
      </div>
  </footer>
</body>
</html>