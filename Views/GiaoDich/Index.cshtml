@model MoneyCare.Models.GiaoDichPageViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Thu chi - Quản lý giao dịch";
    string Tien(decimal so) => so.ToString("#,0.##", CultureInfo.GetCultureInfo("vi-VN")) + " đ";
}

<div class="app">
    <aside class="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index"><i class="bi bi-wallet2"></i> MoneyCare</a>
        <a class="item" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2-fill"></i> Tổng quan</a>
        <a class="item on" asp-controller="GiaoDich" asp-action="Index"><i class="bi bi-arrow-left-right"></i> Thu chi</a>
        <a class="item" asp-controller="Home" asp-action="NganSach"><i class="bi bi-pie-chart-fill"></i> Ngân sách</a>
        <a class="item" asp-controller="Home" asp-action="TietKiem"><i class="bi bi-piggy-bank-fill"></i> Tiết kiệm</a>
        <a class="item" asp-controller="DanhMuc" asp-action="Index"><i class="bi bi-folder"></i> Danh mục</a>
    </aside>

    <section class="content" aria-label="Quản lý giao dịch">
        <h1 class="page-title">Quản lý giao dịch</h1>
        <p class="page-sub">Thêm, sửa, xóa, tìm kiếm và lọc giao dịch của tài khoản đang đăng nhập.</p>

        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-success" role="alert">@TempData["ThongBao"]</div>
        }

        <div class="box mb-4">
            <div class="form-top" style="background:linear-gradient(90deg,#2563eb,#14b8a6)"></div>
            <h2><i class="bi bi-plus-circle-fill text-primary me-2"></i> Thêm giao dịch</h2>
            @if (Model.DanhMuc.Count == 0)
            {
                <div class="alert alert-warning">Tài khoản chưa có danh mục. Hãy tạo danh mục Thu/Chi trong mục <a asp-controller="DanhMuc" asp-action="Index">Danh mục</a> trước khi lưu.</div>
            }

            <form asp-controller="GiaoDich" asp-action="Them" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Form.Loai" class="form-label">Loại giao dịch</label>
                        <select asp-for="Form.Loai" id="themLoai" class="form-select">
                            <option value="Chi">Chi</option>
                            <option value="Thu">Thu</option>
                        </select>
                        <span asp-validation-for="Form.Loai" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Form.MaDanhMuc" class="form-label">Danh mục</label>
                        <select asp-for="Form.MaDanhMuc" id="themDanhMuc" class="form-select">
                            <option value="0">-- Chọn danh mục --</option>
                            @foreach (var d in Model.DanhMuc)
                            {
                                <option value="@d.Id" data-loai="@d.Loai">@d.Ten (@d.Loai)</option>
                            }
                        </select>
                        <span asp-validation-for="Form.MaDanhMuc" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Form.SoTien" class="form-label">Số tiền (VNĐ)</label>
                        <input asp-for="Form.SoTien" type="number" step="0.01" min="0.01" class="form-control" placeholder="Ví dụ: 150000" required />
                        <span asp-validation-for="Form.SoTien" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Form.NgayGiaoDich" class="form-label">Ngày giao dịch</label>
                        <input asp-for="Form.NgayGiaoDich" type="date" class="form-control" required />
                        <span asp-validation-for="Form.NgayGiaoDich" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Form.GhiChu" class="form-label">Ghi chú (không bắt buộc)</label>
                        <textarea asp-for="Form.GhiChu" rows="2" maxlength="500" class="form-control" placeholder="Ví dụ: Mua sách học tập"></textarea>
                        <span asp-validation-for="Form.GhiChu" class="text-danger small"></span>
                    </div>
                </div>
                <button class="btn btn-primary mt-3" type="submit" disabled="@(Model.DanhMuc.Count == 0)">
                    <i class="bi bi-check-circle me-1"></i> Lưu giao dịch
                </button>
            </form>
        </div>

        <div class="box mb-4">
            <h2><i class="bi bi-funnel me-2"></i> Tìm kiếm và lọc lịch sử</h2>
            <form asp-controller="GiaoDich" asp-action="Index" method="get">
                @if (Context.Request.Method == "GET" && !ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="text-danger mb-2"></div>
                }
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="locTuKhoa" class="form-label">Tìm theo ghi chú</label>
                        <input id="locTuKhoa" name="TuKhoa" value="@Model.BoLoc.TuKhoa" maxlength="200" class="form-control" placeholder="Nhập từ khóa..." />
                    </div>
                    <div class="col-md-4">
                        <label for="locLoai" class="form-label">Loại Thu/Chi</label>
                        <select id="locLoai" name="Loai" class="form-select">
                            <option value="">Tất cả</option>
                            <option value="Thu" selected="@(Model.BoLoc.Loai == "Thu")">Thu</option>
                            <option value="Chi" selected="@(Model.BoLoc.Loai == "Chi")">Chi</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="locDanhMuc" class="form-label">Danh mục</label>
                        <select id="locDanhMuc" name="MaDanhMuc" class="form-select">
                            <option value="">Tất cả danh mục</option>
                            @foreach (var d in Model.DanhMuc)
                            {
                                <option value="@d.Id" data-loai="@d.Loai" selected="@(Model.BoLoc.MaDanhMuc == d.Id)">@d.Ten (@d.Loai)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="tuNgay" class="form-label">Từ ngày</label>
                        <input id="tuNgay" name="TuNgay" type="date" value="@(Model.BoLoc.TuNgay?.ToString("yyyy-MM-dd"))" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label for="denNgay" class="form-label">Đến ngày</label>
                        <input id="denNgay" name="DenNgay" type="date" value="@(Model.BoLoc.DenNgay?.ToString("yyyy-MM-dd"))" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label for="locThang" class="form-label">Tháng</label>
                        <select id="locThang" name="Thang" class="form-select">
                            <option value="">Tất cả tháng</option>
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m" selected="@(Model.BoLoc.Thang == m)">Tháng @m</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="locNam" class="form-label">Năm</label>
                        <input id="locNam" name="Nam" type="number" min="1" max="9999" value="@Model.BoLoc.Nam" placeholder="Ví dụ: 2026" class="form-control" />
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i> Lọc giao dịch</button>
                    <a asp-controller="GiaoDich" asp-action="Index" class="btn btn-outline-secondary">Xóa bộ lọc</a>
                </div>
            </form>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4"><div class="box"><div class="text-secondary">Số giao dịch phù hợp</div><div class="fs-4 fw-bold">@Model.TongBanGhi</div></div></div>
            <div class="col-md-4"><div class="box"><div class="text-secondary">Tổng Thu (theo bộ lọc)</div><div class="fs-4 fw-bold text-success">@Tien(Model.TongThu)</div></div></div>
            <div class="col-md-4"><div class="box"><div class="text-secondary">Tổng Chi (theo bộ lọc)</div><div class="fs-4 fw-bold text-danger">@Tien(Model.TongChi)</div></div></div>
        </div>

        <div class="box">
            <h2><i class="bi bi-clock-history me-2"></i> Lịch sử giao dịch của bạn</h2>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr><th>Ngày</th><th>Loại</th><th>Danh mục</th><th>Ghi chú</th><th class="text-end">Số tiền</th><th class="text-end">Thao tác</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.DanhSach.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-secondary py-4">Không có giao dịch phù hợp với bộ lọc.</td></tr>
                        }
                        else
                        {
                            @foreach (var g in Model.DanhSach)
                            {
                                var loai = g.DanhMuc?.Loai ?? "—";
                                <tr>
                                    <td>@g.NgayGiaoDich.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge @(loai == "Thu" ? "bg-success" : loai == "Chi" ? "bg-danger" : "bg-secondary")">@loai</span></td>
                                    <td>@g.DanhMuc?.Ten</td>
                                    <td>@(string.IsNullOrEmpty(g.GhiChu) ? "—" : g.GhiChu)</td>
                                    <td class="text-end fw-bold @(loai == "Thu" ? "text-success" : "text-danger")">@(loai == "Thu" ? "+" : loai == "Chi" ? "−" : "")@Tien(g.SoTien)</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-controller="GiaoDich" asp-action="Sua" asp-route-id="@g.MaGiaoDich" class="btn btn-sm btn-outline-primary" aria-label="Sửa giao dịch">Sửa</a>
                                            <form asp-controller="GiaoDich" asp-action="Xoa" asp-route-id="@g.MaGiaoDich" method="post"
                                                  onsubmit="return confirm('Bạn có chắc muốn xóa giao dịch này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
                <span class="text-secondary small">Trang @Model.Trang / @Model.SoTrang — @Model.TongBanGhi giao dịch</span>
                <div class="d-flex gap-2">
                    @if (Model.Trang > 1)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-trang="@(Model.Trang - 1)"
                           asp-route-TuKhoa="@Model.BoLoc.TuKhoa" asp-route-Loai="@Model.BoLoc.Loai"
                           asp-route-MaDanhMuc="@Model.BoLoc.MaDanhMuc" asp-route-TuNgay="@(Model.BoLoc.TuNgay?.ToString("yyyy-MM-dd"))"
                           asp-route-DenNgay="@(Model.BoLoc.DenNgay?.ToString("yyyy-MM-dd"))" asp-route-Thang="@Model.BoLoc.Thang" asp-route-Nam="@Model.BoLoc.Nam">Trang trước</a>
                    }
                    @if (Model.Trang < Model.SoTrang)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-trang="@(Model.Trang + 1)"
                           asp-route-TuKhoa="@Model.BoLoc.TuKhoa" asp-route-Loai="@Model.BoLoc.Loai"
                           asp-route-MaDanhMuc="@Model.BoLoc.MaDanhMuc" asp-route-TuNgay="@(Model.BoLoc.TuNgay?.ToString("yyyy-MM-dd"))"
                           asp-route-DenNgay="@(Model.BoLoc.DenNgay?.ToString("yyyy-MM-dd"))" asp-route-Thang="@Model.BoLoc.Thang" asp-route-Nam="@Model.BoLoc.Nam">Trang sau</a>
                    }
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            // Tách lọc danh mục trên giao diện; Controller vẫn kiểm tra lại bằng SQL Server.
            function ganLoc(loaiId, danhMucId, tatCa) {
                const loai = document.getElementById(loaiId);
                const dm = document.getElementById(danhMucId);
                if (!loai || !dm) return;
                const ds = Array.from(dm.querySelectorAll('option[data-loai]'))
                    .map(o => ({ id: o.value, ten: o.textContent, loai: o.dataset.loai }));
                function capNhat(giuGiaTri) {
                    const cu = giuGiaTri ? dm.value : '';
                    dm.replaceChildren(new Option(tatCa ? 'Tất cả danh mục' : '-- Chọn danh mục --', tatCa ? '' : '0'));
                    ds.filter(x => !loai.value || x.loai === loai.value)
                        .forEach(x => dm.add(new Option(x.ten, x.id)));
                    if (Array.from(dm.options).some(o => o.value === cu)) dm.value = cu;
                }
                loai.addEventListener('change', () => capNhat(false));
                capNhat(true);
            }
            ganLoc('themLoai', 'themDanhMuc', false);
            ganLoc('locLoai', 'locDanhMuc', true);
        })();
    </script>
}
