@model MoneyCare.Models.GiaoDichPageViewModel
@{
    Layout = null;
    ViewData["Title"] = "Thu chi";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quản lý Thu Chi - MoneyCare</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: "Segoe UI", Arial, sans-serif; background: #f4f7fc; color: #172554; }
        .app { display: flex; min-height: 100vh; }
        
        /* Sidebar */
        .sidebar { width: 250px; min-height: 100vh; flex-shrink: 0; padding: 25px 16px; background: linear-gradient(180deg, #172f59, #1e40af); color: white; }
        .brand { display: flex; align-items: center; gap: 12px; margin: 0 0 38px; padding: 0 8px; color: white; text-decoration: none; font-size: 22px; font-weight: 750; }
        .brand-icon { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 12px; background: #10b981; font-size: 20px; }
        .nav a { display: flex; align-items: center; gap: 14px; padding: 13px 14px; margin-bottom: 7px; border-radius: 10px; color: #dbeafe; text-decoration: none; font-size: 15px; transition: .2s; }
        .nav a i { width: 21px; text-align: center; font-size: 17px; }
        .nav a:hover, .nav a.active { background: #3565c5; color: white; }
        /* Đảm bảo viền vàng hiển thị rõ ràng */
        .nav a.active { box-shadow: inset 4px 0 #fbbf24 !important; }

        /* Main content */
        .main { flex: 1; min-width: 0; padding: 32px 36px; }
        .page-header { display: flex; justify-content: space-between; align-items: center; gap: 15px; margin-bottom: 25px; }
        .page-title { display: flex; align-items: center; gap: 15px; }
        .page-title-icon { width: 54px; height: 54px; display: grid; place-items: center; border-radius: 14px; background: #dbeafe; color: #2563eb; font-size: 27px; }
        .page-title h1 { margin: 0; font-size: 27px; font-weight: 750; color: #172554; }
        .page-title p { margin: 5px 0 0; color: #64748b; font-size: 14px; }

        /* Form Box */
        .form-box { background: white; border: 1px solid #e2e8f0; border-radius: 15px; padding: 25px; box-shadow: 0 3px 12px rgba(15, 23, 42, .04); margin-bottom: 25px; }
        .form-label { font-weight: 600; color: #334155; font-size: 14px; }
        .form-control, .form-select { border-radius: 9px; border: 1px solid #cbd5e1; padding: 10px 14px; font-size: 14px; }
        .form-control:focus, .form-select:focus { border-color: #2563eb; box-shadow: 0 0 0 3px #dbeafe; }
        
        .btn { border: 0; border-radius: 10px; padding: 11px 17px; font-family: inherit; font-size: 14px; font-weight: 650; cursor: pointer; transition: .2s; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
        .btn-primary { background: #2563eb; color: white; }
        .btn-primary:hover { background: #1d4ed8; color: white; }

        /* Table */
        .table-wrap { overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 15px; background: white; box-shadow: 0 3px 12px rgba(15, 23, 42, .04); }
        table { width: 100%; border-collapse: collapse; min-width: 800px; }
        thead { background: #edf2ff; }
        th { padding: 15px 18px; color: #475569; text-align: left; font-size: 12px; font-weight: 750; text-transform: uppercase; }
        td { padding: 15px 18px; border-top: 1px solid #edf0f5; font-size: 14px; vertical-align: middle; }
        tbody tr:hover { background: #f8faff; }

        .type-badge { display: inline-block; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 650; }
        .badge-income { background: #dcfce7; color: #15803d; }
        .badge-expense { background: #ffedd5; color: #c2410c; }

        @@media (max-width: 650px) {
            .sidebar { width: 75px; padding: 20px 9px; }
            .brand { justify-content: center; padding: 0; }
            .brand-text, .nav a span { display: none; }
            .nav a { justify-content: center; padding: 13px 5px; }
            .main { padding: 18px 12px; }
        }
    </style>
</head>
<body>
<div class="app">
    <!-- Sidebar -->
    <aside class="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-icon"><i class="fa-solid fa-wallet"></i></span>
            <span class="brand-text">MoneyCare</span>
        </a>
        <nav class="nav">
            <a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-table-columns"></i> <span>Tổng quan</span></a>
            <a asp-controller="GiaoDich" asp-action="Index" class="active"><i class="fa-solid fa-arrow-right-arrow-left"></i> <span>Thu chi</span></a>
            <a asp-controller="Home" asp-action="NganSach"><i class="fa-solid fa-chart-pie"></i> <span>Ngân sách</span></a>
            <a asp-controller="Home" asp-action="TietKiem"><i class="fa-solid fa-piggy-bank"></i> <span>Tiết kiệm</span></a>
            <a asp-controller="DanhMuc" asp-action="Index"><i class="fa-solid fa-folder-open"></i> <span>Danh mục</span></a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="main">
        <div class="page-header">
            <div class="page-title">
                <div class="page-title-icon"><i class="fa-solid fa-money-bill-transfer"></i></div>
                <div>
                    <h1>Quản lý Thu Chi</h1>
                    <p>Ghi nhận các khoản thu và chi cá nhân.</p>
                </div>
            </div>
        </div>

        @if (TempData["ThongBao"] is not null)
        {
            <div class="alert alert-success" style="border-radius:10px;" role="alert">
                <i class="fa-solid fa-circle-check"></i> @TempData["ThongBao"]
            </div>
        }

        <!-- Form Thêm Giao Dịch -->
        <div class="form-box">
            <h2 style="font-size:18px; font-weight:700; color:#1e293b; margin-bottom:20px;">
                <i class="fa-solid fa-plus-circle text-primary"></i> Thêm giao dịch mới
            </h2>

            @if (Model.DanhMuc.Count == 0)
            {
                <div class="alert alert-warning" style="border-radius:10px;">Tài khoản chưa có danh mục Thu/Chi.</div>
            }

            <form asp-controller="GiaoDich" asp-action="Them" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Form.Loai" class="form-label">Loại giao dịch</label>
                        <select asp-for="Form.Loai" id="loaiGiaoDich" class="form-select">
                            <option value="Chi">Chi tiêu</option>
                            <option value="Thu">Thu nhập</option>
                        </select>
                        <span asp-validation-for="Form.Loai" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Form.MaDanhMuc" class="form-label">Danh mục</label>
                        <select asp-for="Form.MaDanhMuc" id="maDanhMuc" class="form-select">
                            <option value="0">-- Chọn danh mục --</option>
                            @foreach (var dm in Model.DanhMuc)
                            {
                                <option value="@dm.Id" data-loai="@dm.Loai">@dm.Ten</option>
                            }
                        </select>
                        <span asp-validation-for="Form.MaDanhMuc" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Form.SoTien" class="form-label">Số tiền (VNĐ)</label>
                        <input asp-for="Form.SoTien" type="number" min="0.01" step="0.01" class="form-control" placeholder="Ví dụ: 150000" required />
                        <span asp-validation-for="Form.SoTien" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Form.NgayGiaoDich" class="form-label">Ngày giao dịch</label>
                        <input asp-for="Form.NgayGiaoDich" type="date" class="form-control" required />
                        <span asp-validation-for="Form.NgayGiaoDich" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Form.GhiChu" class="form-label">Ghi chú (tùy chọn)</label>
                        <textarea asp-for="Form.GhiChu" rows="2" maxlength="500" class="form-control" placeholder="Nhập nội dung giao dịch..."></textarea>
                        <span asp-validation-for="Form.GhiChu" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary mt-4" disabled="@(Model.DanhMuc.Count == 0)">
                    <i class="fa-solid fa-check-circle"></i> Lưu giao dịch
                </button>
            </form>
        </div>

        <!-- Bảng Lịch sử -->
        <div class="table-wrap">
            <div style="padding: 18px 20px; border-bottom: 1px solid #edf0f5; background: #f8fafc; border-radius: 15px 15px 0 0;">
                <h2 style="margin:0; font-size:16px; font-weight:700; color:#1e293b;">
                    <i class="fa-solid fa-clock-rotate-left"></i> Lịch sử giao dịch
                </h2>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Ngày</th>
                        <th>Loại</th>
                        <th>Danh mục</th>
                        <th>Ghi chú</th>
                        <th class="text-end">Số tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DanhSach.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center text-secondary py-4">Chưa có giao dịch nào được lưu.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.DanhSach)
                        {
                            var loai = item.DanhMuc?.Loai ?? "";
                            <tr>
                                <td style="color:#64748b;">@item.NgayGiaoDich.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (loai == "Thu")
                                    {
                                        <span class="type-badge badge-income">Thu nhập</span>
                                    }
                                    else
                                    {
                                        <span class="type-badge badge-expense">Chi tiêu</span>
                                    }
                                </td>
                                <td style="font-weight:600;">@item.DanhMuc?.Ten</td>
                                <td style="color:#475569;">@item.GhiChu</td>
                                <td class="text-end fw-bold @(loai == "Thu" ? "text-success" : "text-danger")">
                                    @(loai == "Thu" ? "+" : "−")@item.SoTien.ToString("N0")đ
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

<script>
    (function () {
        const loai = document.getElementById("loaiGiaoDich");
        const danhMuc = document.getElementById("maDanhMuc");
        if (!loai || !danhMuc) return;

        const danhSach = Array.from(danhMuc.querySelectorAll("option[data-loai]"))
            .map(o => ({ value: o.value, text: o.textContent.trim(), loai: o.dataset.loai }));

        function capNhatDanhMuc(giuChonCu) {
            const giaTriCu = giuChonCu ? danhMuc.value : "0";
            danhMuc.replaceChildren(new Option("-- Chọn danh mục --", "0"));
            danhSach.filter(d => d.loai === loai.value).forEach(d =>
                danhMuc.add(new Option(d.text, d.value)));
            if (Array.from(danhMuc.options).some(o => o.value === giaTriCu))
                danhMuc.value = giaTriCu;
        }

        loai.addEventListener("change", function () { capNhatDanhMuc(false); });
        capNhatDanhMuc(true);
    })();
</script>
</body>
</html>