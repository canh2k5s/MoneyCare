@model List<MoneyCare.Models.DanhMuc>
@{
    Layout = null;

    string loai = ViewBag.Loai ?? "TatCa";
    string tuKhoa = ViewBag.TuKhoa ?? "";

    int soChi = ViewBag.SoChi ?? 0;
    int soThu = ViewBag.SoThu ?? 0;
    int tongDanhMuc = ViewBag.TongDanhMuc ?? 0;

    string[] icons = {
        "fa-utensils", "fa-house", "fa-bolt", "fa-wifi",
        "fa-bus", "fa-cart-shopping", "fa-heart-pulse",
        "fa-graduation-cap", "fa-gamepad", "fa-shirt",
        "fa-money-bill-wave", "fa-gift", "fa-briefcase", "fa-ellipsis"
    };

    string[] mau = {
        "#2563eb", "#f97316", "#10b981", "#8b5cf6",
        "#eab308", "#ef4444", "#06b6d4", "#ec4899"
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quản lý danh mục - MoneyCare</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: "Segoe UI", Arial, sans-serif; background: #f4f7fc; color: #172554; display: flex; flex-direction: column; min-height: 100vh; }
        .app { display: flex; flex: 1; }

        /* --- HEADER --- */
        .top-header { display: flex; justify-content: space-between; align-items: center; height: 70px; padding: 0 32px; background: white; border-bottom: 1px solid #e2e8f0; flex-shrink: 0; position: relative; z-index: 10; }
        .brand-top { font-size: 24px; font-weight: 750; color: #2563eb; text-decoration: none; display: flex; align-items: center; gap: 10px; }
        .user-menu { display: flex; align-items: center; gap: 15px; }
        .user-name { color: #334155; font-weight: 600; font-size: 15px; }
        .user-name i { color: #2563eb; margin-right: 5px; font-size: 18px; }
        
        .btn-logout { border: 1px solid #2563eb; color: #2563eb; background: transparent; padding: 8px 16px; border-radius: 8px; font-weight: 650; font-size: 14px; text-decoration: none; transition: 0.2s; display: flex; align-items: center; gap: 8px; }
        .btn-logout:hover { background: #2563eb; color: white; }
        
        .btn-register { border: 1px solid #2563eb; background: #2563eb; color: white; padding: 8px 16px; border-radius: 8px; font-weight: 650; font-size: 14px; text-decoration: none; transition: 0.2s; display: flex; align-items: center; gap: 8px; }
        .btn-register:hover { background: #1d4ed8; border-color: #1d4ed8; color: white; }

        /* --- FOOTER --- */
        .app-footer { background: white; padding: 24px 36px; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; flex-shrink: 0; }
        .footer-left { display: flex; flex-direction: column; gap: 8px; }
        .footer-brand { font-size: 22px; font-weight: 750; color: #2563eb; text-decoration: none; display: flex; align-items: center; gap: 10px; }
        .footer-desc { margin: 0; color: #64748b; font-size: 14px; }
        .footer-right { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
        .footer-links { display: flex; gap: 12px; font-size: 14px; color: #cbd5e1; }
        .footer-links a { color: #64748b; text-decoration: none; transition: 0.2s; }
        .footer-links a:hover { color: #2563eb; }
        .footer-copy { color: #94a3b8; font-size: 13px; }

        /* Thanh menu bên trái */
        .sidebar { width: 250px; flex-shrink: 0; padding: 25px 16px; background: linear-gradient(180deg, #172f59, #1e40af); color: white; }
        .brand { display: flex; align-items: center; gap: 12px; margin: 0 0 38px; padding: 0 8px; color: white; text-decoration: none; font-size: 22px; font-weight: 750; }
        .brand-icon { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 12px; background: #10b981; font-size: 20px; }
        .nav a { display: flex; align-items: center; gap: 14px; padding: 13px 14px; margin-bottom: 7px; border-radius: 10px; color: #dbeafe; text-decoration: none; font-size: 15px; transition: .2s; }
        .nav a i { width: 21px; text-align: center; font-size: 17px; }
        .nav a:hover, .nav a.active { background: #3565c5; color: white; }
        .nav a.active { box-shadow: inset 4px 0 #fbbf24; }

        /* Nội dung chính */
        .main { flex: 1; min-width: 0; padding: 32px 36px; }
        .page-header { display: flex; justify-content: space-between; align-items: center; gap: 15px; margin-bottom: 25px; }
        .page-title { display: flex; align-items: center; gap: 15px; }
        .page-title-icon { width: 54px; height: 54px; display: grid; place-items: center; border-radius: 14px; background: #dbeafe; color: #2563eb; font-size: 27px; }
        .page-title h1 { margin: 0; font-size: 27px; font-weight: 750; color: #172554; }
        .page-title p { margin: 5px 0 0; color: #64748b; font-size: 14px; }

        .btn { border: 0; border-radius: 10px; padding: 11px 17px; font-family: inherit; font-size: 14px; font-weight: 650; cursor: pointer; transition: .2s; }
        .btn-primary { background: #2563eb; color: white; }
        .btn-primary:hover { background: #1d4ed8; }

        /* Ba ô thống kê */
        .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-bottom: 24px; }
        .stat-card { display: flex; align-items: center; gap: 16px; min-height: 105px; padding: 18px; border: 1px solid #e2e8f0; border-radius: 15px; }
        .stat-card.total { background: #e8efff; } .stat-card.income { background: #e5f8ed; } .stat-card.expense { background: #fff0e7; }
        .stat-icon { width: 54px; height: 54px; flex-shrink: 0; display: grid; place-items: center; border-radius: 50%; background: rgba(255,255,255,.75); font-size: 23px; }
        .total .stat-icon, .total .stat-number { color: #2563eb; }
        .income .stat-icon, .income .stat-number { color: #16a34a; }
        .expense .stat-icon, .expense .stat-number { color: #ea580c; }
        .stat-label { color: #334155; font-size: 14px; font-weight: 600; }
        .stat-number { margin-top: 3px; font-size: 29px; line-height: 1.1; font-weight: 750; }

        /* Bộ lọc và tìm kiếm */
        .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 15px; flex-wrap: wrap; margin-bottom: 16px; }
        .filters { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .filter { display: inline-flex; align-items: center; gap: 8px; padding: 10px 17px; border: 1px solid #e2e8f0; border-radius: 10px; background: white; color: #475569; text-decoration: none; font-size: 14px; font-weight: 600; }
        .filter.active { border-color: #2563eb; background: #2563eb; color: white; }
        .filter.income i { color: #16a34a; } .filter.expense i { color: #f97316; } .filter.active i { color: white; }
        .search-form { display: flex; align-items: center; gap: 8px; flex: 1; max-width: 430px; }
        .search-box { display: flex; align-items: center; gap: 10px; width: 100%; padding: 0 14px; border: 1px solid #dbe3ef; border-radius: 10px; background: white; color: #64748b; }
        .search-box input { width: 100%; height: 42px; border: 0; outline: none; background: transparent; font-family: inherit; font-size: 14px; }

        /* Bảng danh mục */
        .table-wrap { overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 15px; background: white; box-shadow: 0 3px 12px rgba(15, 23, 42, .04); }
        table { width: 100%; border-collapse: collapse; min-width: 650px; }
        thead { background: #edf2ff; }
        th { padding: 15px 18px; color: #475569; text-align: left; font-size: 12px; font-weight: 750; text-transform: uppercase; }
        td { padding: 12px 18px; border-top: 1px solid #edf0f5; font-size: 14px; }
        tbody tr:hover { background: #f8faff; }
        .category-name { display: flex; align-items: center; gap: 12px; font-weight: 650; color: #1e293b; }
        .category-icon { width: 38px; height: 38px; display: grid; place-items: center; flex-shrink: 0; border-radius: 10px; font-size: 16px; }
        .type-badge { display: inline-block; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 650; }
        .type-income { background: #dcfce7; color: #15803d; } .type-expense { background: #ffedd5; color: #c2410c; }
        .actions { display: flex; align-items: center; gap: 8px; }
        .action-btn { width: 34px; height: 34px; display: grid; place-items: center; border: 0; border-radius: 8px; cursor: pointer; font-size: 14px; }
        .edit-btn { background: #dbeafe; color: #2563eb; } .delete-btn { background: #fee2e2; color: #dc2626; }
        .action-btn:hover { filter: brightness(.95); }
        .table-footer { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 14px 18px; border-top: 1px solid #edf0f5; color: #64748b; font-size: 13px; }
        .empty { padding: 45px 20px; color: #64748b; text-align: center; }
        .empty i { margin-bottom: 12px; color: #94a3b8; font-size: 38px; }
        .alert { padding: 12px 16px; margin-bottom: 16px; border-radius: 10px; font-size: 14px; }
        .alert.ok { background: #dcfce7; color: #166534; } .alert.err { background: #fee2e2; color: #991b1b; }

        /* Hộp thoại thêm/sửa */
        .overlay { position: fixed; inset: 0; z-index: 100; display: none; align-items: center; justify-content: center; padding: 16px; background: rgba(15, 23, 42, .5); }
        .overlay.show { display: flex; }
        .modal { width: 100%; max-width: 490px; max-height: 92vh; overflow-y: auto; padding: 25px; border-radius: 17px; background: white; box-shadow: 0 20px 60px rgba(15, 23, 42, .2); }
        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 22px; }
        .modal-header h2 { margin: 0; font-size: 20px; }
        .close-btn { border: 0; background: transparent; color: #64748b; font-size: 21px; cursor: pointer; }
        .field { margin-bottom: 19px; }
        .field label.title { display: block; margin-bottom: 8px; color: #334155; font-size: 14px; font-weight: 650; }
        .field input[type="text"] { width: 100%; height: 43px; padding: 0 13px; border: 1px solid #cbd5e1; border-radius: 9px; outline: none; font-family: inherit; font-size: 14px; }
        .field input[type="text"]:focus { border-color: #2563eb; box-shadow: 0 0 0 3px #dbeafe; }
        .type-options { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .type-option input { display: none; }
        .type-option label { display: flex; flex-direction: column; align-items: center; gap: 7px; padding: 15px 10px; border: 1px solid #e2e8f0; border-radius: 12px; cursor: pointer; text-align: center; }
        .type-option label i { font-size: 23px; }
        .type-option.income label { background: #f0fdf4; color: #16a34a; } .type-option.expense label { background: #fff7ed; color: #ea580c; }
        .type-option input:checked + label { border: 2px solid currentColor; font-weight: 700; }
        .type-option label span { color: #334155; font-size: 13px; }
        .picks { display: flex; flex-wrap: wrap; gap: 9px; }
        .picks input { display: none; }
        .picks .icon-choice { width: 39px; height: 39px; display: grid; place-items: center; border: 2px solid transparent; border-radius: 10px; background: #f1f5f9; color: #475569; cursor: pointer; }
        .picks input:checked + .icon-choice { border-color: #2563eb; background: #dbeafe; color: #2563eb; }
        .picks .color-choice { width: 29px; height: 29px; display: block; border: 3px solid white; border-radius: 50%; cursor: pointer; box-shadow: 0 0 0 1px #cbd5e1; }
        .picks input:checked + .color-choice { box-shadow: 0 0 0 2px #172554; }
        .modal-footer { display: flex; justify-content: flex-end; gap: 10px; margin-top: 25px; }
        .btn-light { background: #e2e8f0; color: #334155; }

        @@media (max-width: 900px) {
            .sidebar { width: 210px; }
            .main { padding: 24px 20px; }
            .stats { gap: 10px; }
        }
        @@media (max-width: 650px) {
            .sidebar { width: 75px; padding: 20px 9px; }
            .brand { justify-content: center; padding: 0; }
            .brand-text, .nav a span { display: none; }
            .nav a { justify-content: center; padding: 13px 5px; }
            .main { padding: 18px 12px; }
            .stats { grid-template-columns: 1fr; }
            .page-title h1 { font-size: 21px; }
            .search-form { max-width: none; }
            .top-header { padding: 0 15px; }
            .user-name { display: none; }
            .app-footer { flex-direction: column; align-items: flex-start; padding: 20px 15px; }
            .footer-right { align-items: flex-start; }
        }
    </style>
</head>

<body>
    <!-- HEADER -->
    <header class="top-header">
        <a class="brand-top" asp-controller="Home" asp-action="Index">
            <i class="fa-solid fa-wallet"></i> MoneyCare
        </a>
        <div class="user-menu">
            @if (Context.Session.GetInt32("UserId") != null)
            {
                <span class="user-name"><i class="fa-solid fa-circle-user"></i> Xin chào, @(Context.Session.GetString("HoTen") ?? "Người dùng")</span>
                <a href="/Account/Logout" class="btn-logout"><i class="fa-solid fa-arrow-right-from-bracket"></i> Đăng xuất</a>
            }
            else
            {
                <a href="/Account/Login" class="btn-logout">Đăng nhập</a>
                <a href="/Account/Register" class="btn-register"><i class="fa-solid fa-user-plus"></i> Đăng ký</a>
            }
        </div>
    </header>

    <div class="app">
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-icon"><i class="fa-solid fa-wallet"></i></span>
                <span class="brand-text">MoneyCare</span>
            </a>
            <nav class="nav">
                <a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-table-columns"></i> <span>Tổng quan</span></a>
                <a asp-controller="Home" asp-action="GiaoDich"><i class="fa-solid fa-arrow-right-arrow-left"></i> <span>Thu chi</span></a>
                <a asp-controller="Home" asp-action="NganSach"><i class="fa-solid fa-chart-pie"></i> <span>Ngân sách</span></a>
                <a asp-controller="Home" asp-action="TietKiem"><i class="fa-solid fa-piggy-bank"></i> <span>Tiết kiệm</span></a>
                <a asp-controller="DanhMuc" asp-action="Index" class="active"><i class="fa-solid fa-folder-open"></i> <span>Danh mục</span></a>
            </nav>
        </aside>

        <main class="main">
            <div class="page-header">
                <div class="page-title">
                    <div class="page-title-icon"><i class="fa-solid fa-folder-open"></i></div>
                    <div>
                        <h1>Quản lý danh mục</h1>
                        <p>Phân loại chi tiêu, quản lý tài chính hiệu quả hơn</p>
                    </div>
                </div>
                <button class="btn btn-primary" type="button" onclick="moThem()">
                    <i class="fa-solid fa-plus"></i> Thêm danh mục
                </button>
            </div>

            @if (TempData["Ok"] != null) { <div class="alert ok"><i class="fa-solid fa-circle-check"></i> @TempData["Ok"]</div> }
            @if (TempData["Loi"] != null) { <div class="alert err"><i class="fa-solid fa-circle-exclamation"></i> @TempData["Loi"]</div> }

            <section class="stats">
                <div class="stat-card total">
                    <div class="stat-icon"><i class="fa-solid fa-folder"></i></div>
                    <div><div class="stat-label">Tổng danh mục</div><div class="stat-number">@tongDanhMuc</div></div>
                </div>
                <div class="stat-card income">
                    <div class="stat-icon"><i class="fa-solid fa-arrow-up"></i></div>
                    <div><div class="stat-label">Danh mục thu</div><div class="stat-number">@soThu</div></div>
                </div>
                <div class="stat-card expense">
                    <div class="stat-icon"><i class="fa-solid fa-arrow-down"></i></div>
                    <div><div class="stat-label">Danh mục chi</div><div class="stat-number">@soChi</div></div>
                </div>
            </section>

            <div class="toolbar">
                <div class="filters">
                    <a class="filter @(loai == "TatCa" ? "active" : "")" asp-controller="DanhMuc" asp-action="Index" asp-route-loai="TatCa" asp-route-tuKhoa="@tuKhoa"><i class="fa-solid fa-border-all"></i> Tất cả</a>
                    <a class="filter income @(loai == "Thu" ? "active" : "")" asp-controller="DanhMuc" asp-action="Index" asp-route-loai="Thu" asp-route-tuKhoa="@tuKhoa"><i class="fa-solid fa-arrow-up"></i> Thu nhập</a>
                    <a class="filter expense @(loai == "Chi" ? "active" : "")" asp-controller="DanhMuc" asp-action="Index" asp-route-loai="Chi" asp-route-tuKhoa="@tuKhoa"><i class="fa-solid fa-arrow-down"></i> Chi tiêu</a>
                </div>
                <form class="search-form" asp-controller="DanhMuc" asp-action="Index" method="get">
                    <input type="hidden" name="loai" value="@loai" />
                    <div class="search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" name="tuKhoa" value="@tuKhoa" placeholder="Tìm kiếm danh mục..." />
                    </div>
                    <button type="submit" class="btn btn-primary">Tìm</button>
                </form>
            </div>

            <div class="table-wrap">
                @if (!Model.Any())
                {
                    <div class="empty">
                        <i class="fa-regular fa-folder-open"></i>
                        <p>Không tìm thấy danh mục nào.</p>
                        <button type="button" class="btn btn-primary" onclick="moThem()"><i class="fa-solid fa-plus"></i> Thêm danh mục</button>
                    </div>
                }
                else
                {
                    <table>
                        <thead>
                            <tr>
                                <th style="width:55%">Tên danh mục</th>
                                <th style="width:25%">Loại</th>
                                <th style="width:20%">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model)
                            {
                                string icon = d.Icon ?? "fa-tag";
                                string mauDm = d.Mau ?? (d.Loai == "Chi" ? "#f97316" : "#10b981");
                                <tr>
                                    <td>
                                        <div class="category-name">
                                            <span class="category-icon" style="background:@(mauDm)1a;color:@mauDm"><i class="fa-solid @icon"></i></span>
                                            <span>@d.Ten</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (d.Loai == "Thu") { <span class="type-badge type-income">Thu nhập</span> }
                                        else { <span class="type-badge type-expense">Chi tiêu</span> }
                                    </td>
                                    <td>
                                        <div class="actions">
                                            <button type="button" class="action-btn edit-btn" title="Sửa danh mục" data-id="@d.Id" data-ten="@d.Ten" data-loai="@d.Loai" data-icon="@icon" data-mau="@mauDm" onclick="moSua(this)"><i class="fa-solid fa-pen"></i></button>
                                            <form method="post" asp-controller="DanhMuc" asp-action="Xoa" onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@d.Id" />
                                                <button type="submit" class="action-btn delete-btn" title="Xóa danh mục"><i class="fa-solid fa-trash"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="table-footer">
                        <span>Hiển thị @Model.Count danh mục</span>
                        <span>Tổng cộng: @tongDanhMuc danh mục</span>
                    </div>
                }
            </div>
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="app-footer">
        <div class="footer-left">
            <a class="footer-brand" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-wallet"></i> MoneyCare
            </a>
            <p class="footer-desc">Quản lý thu chi thông minh, xây dựng tương lai tài chính tốt hơn.</p>
        </div>
        <div class="footer-right">
            <div class="footer-links">
                <a href="#">Trang chủ</a> |
                <a href="#">Giới thiệu</a> |
                <a href="#">Liên hệ</a>
            </div>
            <div class="footer-copy">
                &copy; 2026 MoneyCare. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- Hộp thoại thêm / sửa danh mục -->
    <div class="overlay" id="overlay" onclick="if(event.target === this) dong()">
        <form class="modal" method="post" asp-controller="DanhMuc" asp-action="Luu">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h2 id="tieuDe"><i class="fa-solid fa-circle-plus" style="color:#2563eb"></i> Thêm danh mục</h2>
                <button type="button" class="close-btn" onclick="dong()"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <input type="hidden" name="Id" id="fId" value="0" />
            <div class="field">
                <label class="title">Tên danh mục <span style="color:red">*</span></label>
                <input type="text" name="Ten" id="fTen" maxlength="50" required placeholder="Ví dụ: Ăn uống" />
            </div>
            <div class="field">
                <label class="title">Loại danh mục <span style="color:red">*</span></label>
                <div class="type-options">
                    <div class="type-option income">
                        <input type="radio" name="Loai" id="loaiThu" value="Thu" checked />
                        <label for="loaiThu"><i class="fa-solid fa-circle-arrow-up"></i><strong>Thu nhập</strong><span>Tiền nhận được</span></label>
                    </div>
                    <div class="type-option expense">
                        <input type="radio" name="Loai" id="loaiChi" value="Chi" />
                        <label for="loaiChi"><i class="fa-solid fa-circle-arrow-down"></i><strong>Chi tiêu</strong><span>Tiền đã chi</span></label>
                    </div>
                </div>
            </div>
            <div class="field">
                <label class="title">Biểu tượng</label>
                <div class="picks">
                    @foreach (var ic in icons) { <label><input type="radio" name="Icon" value="@ic" /><span class="icon-choice"><i class="fa-solid @ic"></i></span></label> }
                </div>
            </div>
            <div class="field">
                <label class="title">Màu sắc</label>
                <div class="picks">
                    @foreach (var m in mau) { <label><input type="radio" name="Mau" value="@m" /><span class="color-choice" style="background:@m"></span></label> }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" onclick="dong()">Hủy bỏ</button>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Lưu danh mục</button>
            </div>
        </form>
    </div>

    <script>
        const overlay = document.getElementById("overlay");
        function chon(name, value) {
            document.querySelectorAll(`input[name="${name}"]`).forEach(input => { input.checked = input.value === value; });
        }
        function moThem() {
            document.getElementById("tieuDe").innerHTML = '<i class="fa-solid fa-circle-plus" style="color:#2563eb"></i> Thêm danh mục';
            document.getElementById("fId").value = "0";
            document.getElementById("fTen").value = "";
            document.getElementById("loaiThu").checked = true;
            chon("Icon", "fa-utensils"); chon("Mau", "#2563eb");
            overlay.classList.add("show"); document.getElementById("fTen").focus();
        }
        function moSua(btn) {
            document.getElementById("tieuDe").innerHTML = '<i class="fa-solid fa-pen" style="color:#2563eb"></i> Sửa danh mục';
            document.getElementById("fId").value = btn.dataset.id;
            document.getElementById("fTen").value = btn.dataset.ten;
            document.getElementById("loaiThu").checked = btn.dataset.loai === "Thu";
            document.getElementById("loaiChi").checked = btn.dataset.loai === "Chi";
            chon("Icon", btn.dataset.icon); chon("Mau", btn.dataset.mau);
            overlay.classList.add("show");
        }
        function dong() { overlay.classList.remove("show"); }
        document.addEventListener("keydown", function (e) { if (e.key === "Escape") dong(); });
    </script>
</body>
</html>