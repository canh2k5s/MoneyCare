@model MoneyCare.Models.NganSach

@{
    ViewData["Title"] = "Thiết lập Ngân sách";
}

<div class="container px-4">
    <h2 class="mt-4">Thiết lập Ngân sách Tháng</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="MaDanhMuc" class="form-label fw-bold">Danh mục chi tiêu</label>
                    <select asp-for="MaDanhMuc" class="form-select" asp-items="ViewBag.MaDanhMuc"></select>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Thang" class="form-label fw-bold">Tháng</label>
                        <input asp-for="Thang" class="form-control" type="number" min="1" max="12" />
                        <span asp-validation-for="Thang" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nam" class="form-label fw-bold">Năm</label>
                        <input asp-for="Nam" class="form-control" type="number" />
                        <span asp-validation-for="Nam" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="HanMuc" class="form-label fw-bold">Hạn mức (VNĐ)</label>
                    <input asp-for="HanMuc" class="form-control" type="number" step="1000" />
                    <span asp-validation-for="HanMuc" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu Ngân Sách</button>
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}