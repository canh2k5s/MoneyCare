
@model MoneyCare.Models.NganSach

@{
    Layout = null;
    ViewData["Title"] = "Chỉnh sửa ngân sách";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chỉnh sửa ngân sách - MoneyCare</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f4f7fc;
            color: #172554;
        }

        .app {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
            flex-shrink: 0;
            padding: 25px 16px;
            background: linear-gradient(180deg, #172f59, #1e40af);
            color: white;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 0 0 38px;
            padding: 0 8px;
            color: white;
            text-decoration: none;
            font-size: 22px;
            font-weight: 750;
        }

        .brand-icon {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: #10b981;
            font-size: 20px;
        }

        .nav a {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 13px 14px;
            margin-bottom: 7px;
            border-radius: 10px;
            color: #dbeafe;
            text-decoration: none;
            font-size: 15px;
        }

        .nav a i {
            width: 21px;
            text-align: center;
        }

        .nav a:hover,
        .nav a.active {
            background: #3565c5;
            color: white;
        }

        .nav a.active {
            box-shadow: inset 4px 0 #fbbf24;
        }

        .main {
            flex: 1;
            min-width: 0;
            padding: 32px 36px;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 25px;
        }

        .page-title {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .page-title-icon {
            width: 54px;
            height: 54px;
            display: grid;
            place-items: center;
            border-radius: 14px;
            background: #dbeafe;
            color: #2563eb;
            font-size: 25px;
        }

        .page-title h1 {
            margin: 0;
            font-size: 27px;
            font-weight: 750;
            color: #172554;
        }

        .page-title p {
            margin: 5px 0 0;
            color: #64748b;
            font-size: 14px;
        }

        .form-box {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 3px 12px rgba(15,23,42,.04);
            max-width: 700px;
        }

        .form-label {
            font-weight: 600;
            color: #334155;
            font-size: 14px;
        }

        .form-control,
        .form-select {
            border-radius: 9px;
            border: 1px solid #cbd5e1;
            padding: 10px 14px;
            font-size: 14px;
        }

        .btn {
            border: 0;
            border-radius: 10px;
            padding: 11px 17px;
            font-size: 14px;
            font-weight: 650;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary {
            background: #2563eb;
            color: white;
        }

        .btn-primary:hover {
            background: #1d4ed8;
            color: white;
        }

        .btn-light {
            background: #e2e8f0;
            color: #334155;
        }

        @@media(max-width:650px) {
            .sidebar {
                width: 75px;
                padding: 20px 9px;
            }

            .brand {
                justify-content: center;
                padding: 0;
            }

            .brand-text,
            .nav a span {
                display: none;
            }

            .nav a {
                justify-content: center;
                padding: 13px 5px;
            }

            .main {
                padding: 18px 12px;
            }
        }
    </style>
</head>

<body>
<div class="app">

    <aside class="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-icon">
                <i class="fa-solid fa-wallet"></i>
            </span>
            <span class="brand-text">MoneyCare</span>
        </a>

        <nav class="nav">
            <a asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-table-columns"></i>
                <span>Tổng quan</span>
            </a>

            <a asp-controller="Home" asp-action="GiaoDich">
                <i class="fa-solid fa-arrow-right-arrow-left"></i>
                <span>Thu chi</span>
            </a>

            <a asp-controller="Home" asp-action="NganSach" class="active">
                <i class="fa-solid fa-chart-pie"></i>
                <span>Ngân sách</span>
            </a>

            <a asp-controller="Home" asp-action="TietKiem">
                <i class="fa-solid fa-piggy-bank"></i>
                <span>Tiết kiệm</span>
            </a>

            <a asp-controller="DanhMuc" asp-action="Index">
                <i class="fa-solid fa-folder-open"></i>
                <span>Danh mục</span>
            </a>
        </nav>
    </aside>

    <main class="main">

        <div class="page-header">
            <div class="page-title">
                <div class="page-title-icon">
                    <i class="fa-solid fa-pen"></i>
                </div>

                <div>
                    <h1>Chỉnh sửa ngân sách</h1>
                    <p>Cập nhật danh mục, thời gian hoặc hạn mức chi tiêu</p>
                </div>
            </div>

            <a asp-controller="NganSach"
               asp-action="Index"
               asp-route-thang="@Model.Thang"
               asp-route-nam="@Model.Nam"
               class="btn btn-light">
                <i class="fa-solid fa-arrow-left"></i>
                Quay lại
            </a>
        </div>

        <div class="form-box">

            <form asp-controller="NganSach"
                  asp-action="Edit"
                  asp-route-id="@Model.MaNganSach"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="MaNganSach" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="MaDanhMuc" class="form-label">
                        Danh mục chi tiêu
                    </label>

                    <select asp-for="MaDanhMuc"
                            class="form-select"
                            asp-items="ViewBag.MaDanhMuc">
                    </select>

                    <span asp-validation-for="MaDanhMuc"
                          class="text-danger small">
                    </span>
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Thang" class="form-label">
                            Tháng
                        </label>

                        <input asp-for="Thang"
                               class="form-control"
                               type="number"
                               min="1"
                               max="12"
                               step="1" />

                        <span asp-validation-for="Thang"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Nam" class="form-label">
                            Năm
                        </label>

                        <input asp-for="Nam"
                               class="form-control"
                               type="number"
                               min="2000"
                               max="2100"
                               step="1" />

                        <span asp-validation-for="Nam"
                              class="text-danger small">
                        </span>
                    </div>

                </div>

                <div class="mb-4">
                    <label asp-for="HanMuc" class="form-label">
                        Hạn mức (VNĐ)
                    </label>

                    <input asp-for="HanMuc"
                           class="form-control"
                           type="number"
                           min="0"
                           step="any"
                           placeholder="Nhập hạn mức ngân sách" />

                    <span asp-validation-for="HanMuc"
                          class="text-danger small">
                    </span>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Lưu thay đổi
                </button>

                <a asp-controller="NganSach"
                   asp-action="Index"
                   asp-route-thang="@Model.Thang"
                   asp-route-nam="@Model.Nam"
                   class="btn btn-light ms-2">
                    Hủy
                </a>

            </form>

        </div>

    </main>

</div>
</body>
</html>
